# Authelia built from the received source, the same way authelia-scripts does it:
# web (pnpm/vite) → internal/server/public_html, copy api/, go build. The upstream Dockerfile expects a CI-built binary.
FROM node:22-alpine AS web
WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN npx -y pnpm@12.6.0 install --frozen-lockfile --ignore-scripts
COPY . /src
RUN npx -y pnpm@12.6.0 build

FROM golang:1.27-alpine AS build
# Authelia's SQLite storage driver (mattn/go-sqlite3) needs cgo.
RUN apk add --no-cache gcc musl-dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/internal/server/public_html ./internal/server/public_html
RUN cp -r api internal/server/public_html/ && CGO_ENABLED=1 go build -trimpath -ldflags '-s -w' -o /out/authelia ./cmd/authelia

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata wget
COPY --from=build /out/authelia /app/authelia
ENV X_AUTHELIA_CONFIG=/config/configuration.yml X_AUTHELIA_CONFIG_FILTERS=template
EXPOSE 9091
VOLUME /config
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s CMD wget -q -O /dev/null http://127.0.0.1:9091/api/health || exit 1
ENTRYPOINT ["/app/authelia"]
