# OpenCut web (apps/web, TanStack Start for Cloudflare Workers) built with Bun and served by vite preview,
# which runs the built worker in workerd (@cloudflare/vite-plugin). For Cloudflare itself: bun run deploy.
FROM oven/bun:1
WORKDIR /src/apps/web
COPY apps/web/package.json ./
RUN bun install
COPY apps/web/ ./
RUN bun run build
EXPOSE 4173
CMD ["bun", "x", "vite", "preview", "--host", "0.0.0.0", "--port", "4173", "--strictPort"]
