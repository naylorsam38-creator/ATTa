# ntfy built from the received source the way its Makefile does: web (npm ci + build → server/site),
# placeholder docs (cli-deps-static-sites), go build (cgo for SQLite).
FROM node:22-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build && mv build/index.html build/app.html && rm -f build/config.js

FROM golang:1.25-alpine AS build
RUN apk add --no-cache gcc musl-dev git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN rm -rf server/site && mkdir -p server/docs && touch server/docs/index.html
COPY --from=web /src/web/build ./server/site
RUN CGO_ENABLED=1 go build -o /out/ntfy .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && adduser -D -H -u 1000 ntfy && mkdir -p /var/cache/ntfy && chown ntfy /var/cache/ntfy
COPY --from=build /out/ntfy /usr/bin/ntfy
USER ntfy
EXPOSE 8081
VOLUME /var/cache/ntfy
ENTRYPOINT ["ntfy"]
CMD ["serve", "--listen-http", ":8081", "--cache-file", "/var/cache/ntfy/cache.db"]
