# ILLA Builder frontend built from the received source. GitHub zips never contain git submodules, so the
# build clones packages/illa-design and packages/illa-public-component (branch beta, per .gitmodules) when empty.
FROM node:22 AS build
WORKDIR /src
COPY . .
RUN [ -f packages/illa-design/package.json ] || (rm -rf packages/illa-design && git clone -q --depth 1 https://github.com/illacloud/illa-design.git packages/illa-design) \
 && ([ -d packages/illa-public-component/AuthShown ] || (rm -rf packages/illa-public-component && git clone -q --depth 1 --branch beta https://github.com/illacloud/illa-public-component.git packages/illa-public-component))
RUN HUSKY=0 npx -y pnpm@8 install --no-frozen-lockfile
RUN cd apps/builder && NODE_OPTIONS=--max-old-space-size=8192 npx vite build --mode self

FROM nginx:1.27-alpine
COPY --from=build /src/apps/builder/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
