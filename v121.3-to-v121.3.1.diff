diff --git a/04-deployment/coolify_live.py b/04-deployment/coolify_live.py
new file mode 100644
index 0000000..c650e42
--- /dev/null
+++ b/04-deployment/coolify_live.py
@@ -0,0 +1,261 @@
+#!/usr/bin/env python3
+"""
+coolify_live.py — after the hand-off, prove each app is really live in Coolify.
+
+A Coolify deploy call being ACCEPTED only means Coolify queued it. Per handed-off app this walks:
+
+  DISPATCHED  Coolify accepted the deploy / created the service (coolify_handoff)
+  DEPLOYING   waiting for Coolify to report the service running AND its containers to be running
+  RUNNING     Coolify says running, every container of the service is running, and the app's
+              address answers HTTP through Coolify's proxy (not a 5xx)
+  VERIFIED    the six-stage watcher, stage 6 = real Chromium + the app's journey, passed against
+              the LIVE Coolify address (not the test run's local container)
+  LIVE_FAILED stopped at the step named in `failed_at`, with the evidence: Coolify's service status,
+              container states, container logs, the HTTP answer, the watcher result and its evidence
+
+Each step is observed, never inferred: DISPATCHED is not RUNNING and RUNNING is not VERIFIED. The live check
+runs once per deployment (no blind retries); a failure is recorded with its evidence and left for a repair.
+Everything lands on the build record under coolify.apps.<app>.live and in
+state/coolify/live/<app>/<build>/live-<n>.json (never overwritten).
+"""
+from __future__ import annotations
+import json, os, re, subprocess, time
+from pathlib import Path
+from urllib.request import Request, build_opener, ProxyHandler, HTTPRedirectHandler
+from urllib.error import HTTPError, URLError
+
+import builds
+
+# ===================== CONFIG =====================
+DEPLOY_WAIT = int(os.environ.get("COOLIFY_LIVE_DEPLOY_WAIT", "1800"))   # most seconds DISPATCHED -> RUNNING
+REACH_WAIT = int(os.environ.get("COOLIFY_LIVE_REACH_WAIT", "600"))      # most seconds RUNNING -> answers HTTP
+CHECK_EVERY = int(os.environ.get("COOLIFY_LIVE_CHECK_EVERY", "30"))     # seconds between observations
+ROOT = builds.ROOT
+LIVE = ROOT / "state" / "coolify" / "live"
+# ===================================================
+FINAL = ("VERIFIED", "LIVE_FAILED")
+_HTTP = build_opener(ProxyHandler({}))
+
+
+def _sh(cmd, timeout=60) -> tuple[int, str]:
+    try:
+        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
+        return r.returncode, (r.stdout or "") + (r.stderr or "")
+    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
+        return 124, str(e)
+
+
+def service_status(uuid: str) -> dict:
+    """What Coolify itself says about the service: its status and the address of each part."""
+    import coolify_provision as prov
+    try:
+        st, body = prov._api("GET", f"/services/{uuid}")
+    except Exception as e:
+        return {"http": None, "error": f"{type(e).__name__}: {e}"}
+    if st != 200 or not isinstance(body, dict):
+        return {"http": st, "error": str(body)[:500]}
+    parts = []
+    for a in (body.get("applications") or []):
+        if isinstance(a, dict):
+            parts.append({"name": a.get("name"), "status": a.get("status"), "fqdn": a.get("fqdn")})
+    return {"http": st, "status": body.get("status"), "name": body.get("name"), "uuid": body.get("uuid"),
+            "project_uuid": ((body.get("environment") or {}).get("project") or {}).get("uuid") if isinstance(body.get("environment"), dict) else None,
+            "environment_id": body.get("environment_id"), "parts": parts}
+
+
+def containers(uuid: str) -> list[dict]:
+    """Coolify names a service's containers <part>-<service uuid>: the real containers on this Docker."""
+    rc, out = _sh(["docker", "ps", "-a", "--filter", f"name={uuid}", "--format", "{{json .}}"])
+    rows = []
+    for line in out.splitlines():
+        try:
+            d = json.loads(line)
+        except ValueError:
+            continue
+        rows.append({"name": d.get("Names"), "id": d.get("ID"), "image": d.get("Image"), "state": d.get("State"),
+                     "status": d.get("Status")})
+    return rows
+
+
+def live_url(app: str, st: dict, svc: dict) -> str | None:
+    import coolify_handoff as h
+    url = st.get("url") or (h._managed().get(app) or {}).get("url")
+    if not url:
+        import coolify_provision as prov
+        skin = next((p for p in svc.get("parts") or [] if p.get("name") == prov.SKIN_SERVICE and p.get("fqdn")), None)
+        any_ = next((p for p in svc.get("parts") or [] if p.get("fqdn")), None)
+        url = (skin or any_ or {}).get("fqdn")
+    if url:
+        url = str(url).split(",")[0].strip()
+    return url or None
+
+
+def http_get(url: str, timeout: int = 15) -> dict:
+    try:
+        with _HTTP.open(Request(url, headers={"Accept": "text/html,*/*"}), timeout=timeout) as r:
+            return {"http_status": r.status, "final_url": r.geturl(), "content_type": r.headers.get("Content-Type", "")}
+    except HTTPError as e:
+        return {"http_status": e.code, "final_url": url, "content_type": e.headers.get("Content-Type", "") if e.headers else ""}
+    except (URLError, OSError, ValueError) as e:
+        return {"http_status": None, "error": f"{type(e).__name__}: {e}"}
+
+
+def _logs(rows: list[dict], path: Path) -> str | None:
+    text = []
+    for c in rows:
+        rc, out = _sh(["docker", "logs", "--tail", "200", c["name"]], timeout=30)
+        text.append(f"===== {c['name']} ({c.get('image')}) {c.get('status')} =====\n{out}")
+    try:
+        path.write_text("\n".join(text))
+        return str(path)
+    except OSError:
+        return None
+
+
+def _record(app: str, bid: str, live: dict) -> str | None:
+    import app_runner
+    d = LIVE / app_runner.safe_id(app) / re.sub(r"[^A-Za-z0-9_.-]", "-", bid)
+    d.mkdir(parents=True, exist_ok=True)
+    n = len(list(d.glob("live-*.json"))) + 1
+    p = d / f"live-{n}.json"
+    while p.exists():
+        n += 1; p = d / f"live-{n}.json"
+    try:
+        p.write_text(json.dumps(live, indent=2, default=str) + "\n")
+        return str(p)
+    except OSError:
+        return None
+
+
+def live_check(app: str, bid: str, url: str, live: dict) -> dict:
+    """The six stages against the LIVE Coolify address. The skin files are the snapshot that is live."""
+    import app_runner, system_watcher as w, resilience
+    aid = app_runner.safe_id(app)
+    snap = LIVE / aid / re.sub(r"[^A-Za-z0-9_.-]", "-", bid) / ".ui-capability"
+    try:
+        t0 = json.loads((app_runner.TARGETS / f"{aid}.json").read_text())
+    except (OSError, ValueError):
+        t0 = {}
+    t = {"app": aid, "ui_dir": str(snap if snap.is_dir() else t0.get("ui_dir", "")), "target_url": url, "proxy_url": url,
+         "profile": t0.get("profile")}
+    # The journey runs against the live instance. A fresh deployment has its own database, so an account
+    # the test run created does not exist there: the journey is authored against the live app the same
+    # way the test run authored it (journey_author), unless the app's recipe carries its own contract.
+    recipe = app_runner.load_recipe(app) or {}
+    authored = None
+    if isinstance(recipe.get("journey"), dict):
+        t["journey"] = recipe["journey"]
+    elif (t.get("profile") or "web") == "web":
+        try:
+            import journey_author
+            authored = journey_author.author(aid, url, recipe, log=lambda m: print(f"  [{aid} live]{m}", flush=True))
+            t["journey"] = authored["journey"] or {"error": authored["code"], "detail": authored["detail"]}
+        except Exception as e:
+            t["journey"] = {"error": "LIVE_JOURNEY_AUTHOR_EXCEPTION", "detail": f"{type(e).__name__}: {e}"}
+    ident = {"run_id": f"live-{aid}-{int(time.time() * 1000)}", "attempt": 1, "source": "coolify_live",
+             "correlation_id": resilience.new_correlation_id(),
+             "deployment_revision": resilience.deployment_revision(ROOT), "app_revision": app_runner._app_revision_of(app)}
+    r = w.check({**t, "_identity": ident})
+    if authored is not None:
+        r["journey_author"] = {k: authored.get(k) for k in ("account", "code", "detail")}
+    r["identity"] = ident
+    return r
+
+
+def step(bid: str, app: str, st: dict) -> dict:
+    """Advance one app's live state by one observation. Returns the updated live block."""
+    live = dict(st.get("live") or {})
+    now = time.time()
+    if live.get("state") in FINAL or now < float(live.get("next_at", 0)):
+        return live
+    uuid = st.get("uuid")
+    live.setdefault("state", "DISPATCHED")
+    live.setdefault("dispatched_at", st.get("at") or now)
+    live["service_uuid"] = uuid
+    live["deploy_detail"] = st.get("detail")
+    svc = service_status(uuid) if uuid else {"error": "no Coolify uuid"}
+    rows = containers(uuid) if uuid else []
+    live.update({"observed_at": now, "coolify_service": svc, "containers": rows})
+    base = LIVE / re.sub(r"[^a-z0-9-]+", "-", app.lower()).strip("-") / re.sub(r"[^A-Za-z0-9_.-]", "-", bid)
+    base.mkdir(parents=True, exist_ok=True)
+
+    def fail(where: str, why: str) -> dict:
+        live.update({"state": "LIVE_FAILED", "failed_at": where, "reason": why, "finished_at": now,
+                     "container_logs": _logs(rows, base / f"containers-{int(now)}.log") if rows else None})
+        live["record"] = _record(app, bid, live)
+        print(f"[{app} live] LIVE_FAILED at {where}: {why}", flush=True)
+        return live
+
+    running = str(svc.get("status") or "").startswith("running") and rows and all(c.get("state") == "running" for c in rows)
+    if live["state"] in ("DISPATCHED", "DEPLOYING"):
+        if running:
+            live.update({"state": "RUNNING", "running_at": now})
+        else:
+            live["state"] = "DEPLOYING"
+            if now - float(live["dispatched_at"]) > DEPLOY_WAIT:
+                return fail("DEPLOYING", f"not running after {DEPLOY_WAIT}s: Coolify status {svc.get('status')!r}, "
+                                         f"containers {[(c['name'], c['state'], c['status']) for c in rows]}")
+            live["next_at"] = now + CHECK_EVERY
+            return live
+    if live["state"] == "RUNNING":
+        if not running:
+            return fail("RUNNING", f"stopped running after it started: Coolify status {svc.get('status')!r}, "
+                                   f"containers {[(c['name'], c['state'], c['status']) for c in rows]}")
+        url = live_url(app, st, svc)
+        live["url"] = url
+        if not url:
+            return fail("REACHABLE", "Coolify gives the service no address")
+        h = http_get(url)
+        live["http"] = h
+        if h.get("http_status") is None or h["http_status"] >= 500:
+            if now - float(live.get("running_at", now)) > REACH_WAIT:
+                return fail("REACHABLE", f"{url} answers {h.get('http_status') or h.get('error')} "
+                                         f"{REACH_WAIT}s after Coolify reported it running")
+            live["next_at"] = now + CHECK_EVERY
+            return live
+        live["reachable_at"] = now
+        print(f"[{app} live] RUNNING and reachable at {url} (HTTP {h['http_status']}); running the six stages live", flush=True)
+        try:
+            r = live_check(app, bid, url, live)
+        except Exception as e:
+            return fail("LIVE_CHECK", f"the live check itself raised {type(e).__name__}: {e}")
+        clean = (r.get("stages") or {}).get("6 CLEAN") or {}
+        live["check"] = {"verdict": r.get("verdict"), "broken_at": r.get("broken_at"), "code": r.get("code"),
+                         "stages": {k: {x: v.get(x) for x in ("status", "code", "detail")} for k, v in (r.get("stages") or {}).items()},
+                         "evidence": clean.get("evidence"), "journey": clean.get("journey"),
+                         "journey_author": r.get("journey_author"), "identity": r.get("identity")}
+        if r.get("broken_at") is None and clean.get("status") == "OK":
+            live.update({"state": "VERIFIED", "verified_at": now, "finished_at": now})
+            live["record"] = _record(app, bid, live)
+            print(f"[{app} live] VERIFIED at {url}", flush=True)
+            return live
+        return fail(f"LIVE {r.get('broken_at') or '6 CLEAN'}", f"{r.get('code') or clean.get('code')}: "
+                                                                  f"{str(((r.get('stages') or {}).get(r.get('broken_at') or '6 CLEAN') or {}).get('detail') or '')[:400]}")
+    return live
+
+
+def verify_pending() -> None:
+    """Called from the pipeline loop: advance every accepted app of every handed-off build."""
+    for rec in builds.all_builds():
+        c = rec.get("coolify") or {}
+        apps = c.get("apps") or {}
+        changed = False
+        for app, st in apps.items():
+            if st.get("status") != "ACCEPTED" or (st.get("live") or {}).get("state") in FINAL:
+                continue
+            try:
+                new = step(rec["id"], app, st)
+            except Exception as e:
+                new = {**(st.get("live") or {}), "state": "LIVE_FAILED", "failed_at": "LIVE_OBSERVER",
+                       "reason": f"{type(e).__name__}: {e}", "finished_at": time.time()}
+            if new != st.get("live"):
+                st["live"] = new; changed = True
+        if changed:
+            cur = builds.get(rec["id"]) or {}
+            cc = cur.get("coolify") or {}
+            for app, st in apps.items():
+                if app in (cc.get("apps") or {}) and st.get("live"):
+                    cc["apps"][app]["live"] = st["live"]
+            states = [((cc.get("apps") or {}).get(a) or {}).get("live", {}).get("state") for a in (cc.get("apps") or {})]
+            cc["live_summary"] = {s: states.count(s) for s in set(states) if s}
+            builds.update(rec["id"], coolify=cc)
