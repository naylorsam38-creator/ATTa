diff -ruN a/05-coolify/kit/scripts/lib/common.sh b/05-coolify/kit/scripts/lib/common.sh
--- a/05-coolify/kit/scripts/lib/common.sh	2026-09-28 14:29:58.000000000 +0000
+++ b/05-coolify/kit/scripts/lib/common.sh	2026-09-29 00:25:01.189670852 +0000
@@ -507,3 +507,100 @@
     fail "Reverse proxy did not come up and stay up. Check: docker logs coolify-proxy, and Servers > localhost > Proxy in the dashboard"
     return 1
 }
+
+# ---------------------------------------------------------------- Docker Hub mirror
+# Docker Hub rate-limits anonymous pulls (HTTP 429 "toomanyrequests"). ATTa pulls many base
+# images at once, so every Docker Hub download is sent through Google's public Docker Hub
+# cache first; Docker falls back to Docker Hub itself on a miss.
+#
+# This must be done on the HOST, after Coolify's installer: that installer rewrites
+# /etc/docker/daemon.json (dropping any mirror set earlier), and ATTa's own runtime 429 repair
+# (app_runner.fix_rate_limit) cannot reach the host's Docker config from inside its container.
+# Idempotent: merges into the existing file (Coolify's log and address-pool settings are kept),
+# backs it up, restarts Docker only when something changed, and puts the old file back if Docker
+# will not start with the new one.
+DOCKER_DAEMON_JSON="${DOCKER_DAEMON_JSON:-/etc/docker/daemon.json}"
+ATTA_REGISTRY_MIRROR="${ATTA_REGISTRY_MIRROR-https://mirror.gcr.io}" # empty = leave Docker as it is
+
+registry_mirror_set() { # registry_mirror_set FILE MIRROR -> 0 if FILE already lists MIRROR
+    [ -f "$1" ] && jq -e --arg m "$2" '(.["registry-mirrors"] // []) | index($m) != null' "$1" >/dev/null 2>&1
+}
+
+docker_restart() {
+    if [ -n "${DOCKER_RESTART_CMD:-}" ]; then
+        eval "$DOCKER_RESTART_CMD"
+    elif [ -d /run/systemd/system ]; then
+        systemctl restart docker
+    else
+        service docker restart
+    fi
+}
+
+docker_ready() { # docker_ready SECONDS
+    local deadline=$((SECONDS + ${1:-90}))
+    until docker info >/dev/null 2>&1; do
+        [ "$SECONDS" -lt "$deadline" ] || return 1
+        sleep 2
+    done
+}
+
+docker_mirrors_active() { # docker_mirrors_active MIRROR -> 0 if the running daemon uses it
+    docker info --format '{{json .RegistryConfig.Mirrors}}' 2>/dev/null | jq -e --arg m "$1" \
+        'map(rtrimstr("/")) | index($m | rtrimstr("/")) != null' >/dev/null 2>&1
+}
+
+ensure_registry_mirror() {
+    local m="$ATTA_REGISTRY_MIRROR" f="$DOCKER_DAEMON_JSON" backup="" tmp
+    if [ -z "$m" ]; then
+        info "Docker Hub mirror disabled (ATTA_REGISTRY_MIRROR is empty)"
+        return 0
+    fi
+    if registry_mirror_set "$f" "$m"; then
+        if docker_mirrors_active "$m"; then
+            ok "Docker Hub downloads already go through $m"
+            return 0
+        fi
+        info "Docker Hub mirror is in $f but the running Docker does not use it yet"
+    else
+        if [ -f "$f" ] && ! jq -e 'type == "object"' "$f" >/dev/null 2>&1; then
+            warn "$f is not a JSON object; not changing it. Docker Hub downloads are NOT mirrored."
+            return 1
+        fi
+        mkdir -p "$(dirname "$f")"
+        tmp="$(mktemp "$f.XXXXXX")"
+        if [ -f "$f" ]; then
+            backup="$f.atta-backup-$(date -u +%Y%m%dT%H%M%SZ)"
+            cp -p "$f" "$backup"
+            jq --arg m "$m" '.["registry-mirrors"] = ((.["registry-mirrors"] // []) + [$m])' "$f" >"$tmp"
+        else
+            jq -n --arg m "$m" '{"registry-mirrors": [$m]}' >"$tmp"
+        fi
+        chmod 644 "$tmp"
+        mv -f "$tmp" "$f"
+        info "Added Docker Hub mirror $m to $f${backup:+ (previous file: $backup)}"
+    fi
+    info "Restarting Docker to load the mirror (running containers come back by their restart policy)"
+    if docker_restart && docker_ready "${DOCKER_READY_SECONDS:-90}" && docker_mirrors_active "$m"; then
+        ok "Docker Hub downloads now go through $m"
+        return 0
+    fi
+    fail "Docker did not come back using the mirror."
+    if [ -n "$backup" ]; then
+        warn "Putting the previous $f back"
+        cp -p "$backup" "$f"
+    elif [ -f "$f" ] && [ "$(jq -c 'keys' "$f" 2>/dev/null)" = '["registry-mirrors"]' ]; then
+        warn "Removing the $f this step created"
+        rm -f "$f"
+    fi
+    docker_restart || true
+    docker_ready "${DOCKER_READY_SECONDS:-90}" || fail "Docker is still not running. Check: journalctl -u docker"
+    return 1
+}
+
+wait_for_coolify_api() { # wait_for_coolify_api [SECONDS] -> 0 once /api/health says OK
+    local deadline=$((SECONDS + ${1:-240}))
+    until [ "$(curl -fsS -m 5 "http://127.0.0.1:${APP_PORT:-8000}/api/health" 2>/dev/null)" = "OK" ]; do
+        [ "$SECONDS" -lt "$deadline" ] || return 1
+        sleep 3
+    done
+}
