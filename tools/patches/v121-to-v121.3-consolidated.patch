diff --git a/05-coolify/kit/scripts/install.sh b/05-coolify/kit/scripts/install.sh
index c5955c4..9e221f7 100755
--- a/05-coolify/kit/scripts/install.sh
+++ b/05-coolify/kit/scripts/install.sh
@@ -153,6 +153,10 @@ done
 run_coolify_installer "$COOLIFY_VERSION" "${install_env[@]}" ||
     die "Coolify installation failed. Fix the error above and re-run; the installer is safe to re-run."
 
+# Coolify's installer rewrites /etc/docker/daemon.json, so the Docker Hub mirror goes in after it.
+ensure_registry_mirror || warn "Docker Hub mirror not set: app builds may hit Docker Hub's HTTP 429 rate limit"
+wait_for_coolify_api || die "Coolify's API did not come back after the Docker restart. Check: docker logs coolify"
