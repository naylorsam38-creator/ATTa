+def _select_fix(a: str, r: dict, tried: set) -> dict | None:
+    """ATTa's own repair tiers, cheapest first, evidence-based only: tier 1 known fixes (built-in and learned
+    rules keyed on the failure), tier 2 the capability adapter (repairs what its inspection actually finds).
+    The self-healer's blind probe is NOT used here. A fix already tried for this failure is not offered again."""
+    st = r.get("broken_at")
+    item = {"key": f"{st}:{r.get('code')}", "app": safe_id(a),
+            "detail": str(((r.get("stages") or {}).get(st) or {}).get("detail") or "")[:2000]}
+    try:
+        import known_fixes
+        m = known_fixes.match("qualify", item, _FLEET.get("fleet_run_id") or "")
+    except Exception as e:
+        m = None
+        item["tier1_error"] = f"{type(e).__name__}: {e}"
+    if m and m.get("human"):
+        return {"tier": 1, "rule": m["rule"], "human": m["human"], "item": item}
+    if m and m.get("actions"):
+        key = (m["rule"], json.dumps(m["actions"], sort_keys=True, default=str))
+        if key not in tried:
+            return {"tier": 1, "rule": m["rule"], "actions": m["actions"], "key": key, "item": item}
+    try:
+        import capability_adapter
+        p = capability_adapter.plan(item)
+    except Exception as e:
+        p = None
+        item["tier2_error"] = f"{type(e).__name__}: {e}"
+    if p and p.get("actions"):
+        key = ("adapter", json.dumps(p["actions"], sort_keys=True, default=str))
+        if key not in tried:
+            return {"tier": 2, "rule": "capability_adapter", "findings": p.get("findings"), "actions": p["actions"],
+                    "key": key, "item": item}
+    if p and not p.get("actions"):
+        return {"tier": 2, "rule": "capability_adapter", "human": "; ".join(p.get("findings") or []) or "adapter: nothing it can repair",
+                "item": item}
+    return None
+
