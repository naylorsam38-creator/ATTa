+def _run_pool(apps: list[str], log, n: int, gate: bool) -> dict[str, dict]:
+    """Run each app's job in a worker (at most n at once). Every app gets a result: its own, a contained
+    WORKER_EXCEPTION, or WORKER_TIMEOUT when its job outlives APP_HARD_TIMEOUT (then the fleet stops
+    waiting for it, stops its containers, and a late result is kept aside, never over the recorded one)."""
+    from concurrent.futures import ThreadPoolExecutor, wait, FIRST_COMPLETED
+    out: dict[str, dict] = {}
+    pool = ThreadPoolExecutor(max_workers=max(1, n), thread_name_prefix="atta-app")
+    futs = {}
+    for a in apps:
+        _STARTED.pop(safe_id(a), None)
+        futs[pool.submit(_qualify_one, a, log, gate)] = a
+    pending = set(futs)
+    abandoned = False
+    try:
+        while pending:
+            done, pending = wait(pending, timeout=_POOL_POLL, return_when=FIRST_COMPLETED)
+            for f in done:
+                a = futs[f]
+                try:
+                    out[safe_id(a)] = f.result()
+                except KeyboardInterrupt:
+                    raise
+                except BaseException as e:   # _qualify_one contains everything; this is the last line
+                    out[safe_id(a)] = _contained_failure(a, "WORKER_EXCEPTION", e)
+            if APP_HARD_TIMEOUT > 0:
+                now = time.time()
+                for f in list(pending):
+                    a = futs[f]
+                    t0 = _STARTED.get(safe_id(a))
+                    if t0 is not None and now - t0 > APP_HARD_TIMEOUT:
+                        pending.discard(f)
+                        abandoned = True
+                        out[safe_id(a)] = _abandon(a, now - t0, log)
+    finally:
+        pool.shutdown(wait=not abandoned)
     return out
 
 
