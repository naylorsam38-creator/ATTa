+def _apply(actions, a: str | None = None, fail: dict | None = None, tier=None) -> tuple[bool, list[dict]]:
+    """Run the chosen repair's actions (repair_actions.py, the only thing that changes anything). With the app
+    and its failure record given, each action first goes through the control layer's gate (atta_control), exactly
+    as maintenance.py's do: identity, evidence and policy are audited to state/control/, and with
+    ATTA_CONTROL_ENFORCE=1 an unidentifiable or stale repair is refused (it then fails here as FIX_FAILED).
+    Default (unset): audit only; the repair runs exactly as it did before."""
+    import repair_actions as ra
+    done, ok = [], True
+    rec = item = None
+    if a is not None and fail is not None:
+        job = dict(getattr(_CTX, "job", None) or {})
+        ver = {x: job.get(x) for x in ("run_id", "correlation_id", "attempt", "app_revision", "deployment_revision")}
+        rec = {"id": job.get("run_id") or "norun", "app": safe_id(a), "verification": ver, "updated": fail.get("at")}
+        item = {"app": safe_id(a), "broken_at": fail.get("stage"), "code": fail.get("code"),
+                "detail": fail.get("error"), "timestamp": fail.get("at"), "verification": ver}
+    for name, args in actions:
+        try:
+            if rec is not None:
+                from atta_control.integration import authorize_and_run
+                out = authorize_and_run(rec=rec, item=item, layer=f"runner-tier{tier}", action_name=name,
+                                        run_callable=lambda n=name, g=args: ra.run(n, g))
+            else:
+                out = ra.run(name, args)
+            err = False
+        except Exception as e:
+            out, err, ok = f"{type(e).__name__}: {e}", True, False
+        done.append({"name": name, "args": args, "result": str(out)[:1000], "error": err})
+        if err:
+            break
+    return ok, done
