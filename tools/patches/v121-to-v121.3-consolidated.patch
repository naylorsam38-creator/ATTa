+def _retest(a: str, r: dict, plan: dict, log) -> dict:
+    """Re-run the failed stage. The app stays up when the fix did not touch how it starts: the watcher walks
+    stages 1 -> 6 again on the running app (the earlier stages are read-only checks: they are the regression
+    check). A fix to how it starts restarts it through the normal runner."""
+    run = r.get("runner") or {}
+    tp = TARGETS / f"{safe_id(a)}.json"
+    if not plan.get("restart_app") and run.get("started") and tp.is_file():
+        try:
+            t = json.loads(tp.read_text())
+        except (OSError, ValueError):
+            t = None
+        if t is not None:
+            t.pop("parked", None); t.pop("parked_at", None)
+            r2 = _watcher().check({**t, "_identity": {**_job_identity(a), "source": "app_runner.repair_retest"}})
+            r2["runner"] = {**run, "retest": "watcher on the running app"}
+            for k in ("observations", "journey_author", "timing", "number"):
+                if k in r and k not in r2:
+                    r2[k] = r[k]
+            return r2
+    log(f"  [{a}] retest restarts the app (the fix changes how it starts, or it is not running)")
+    return qualify_app(a, keep=True, log=log)
