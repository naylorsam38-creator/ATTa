+                    return self.passing("svc")
+            self.ar._watcher = lambda: FakeW()
+            r = self.ar._qualify_one("svc", self.log)
+        finally:
+            srv.shutdown(); srv.server_close(); th.join(3)
+        self.assertNotIn("_identity", seen["file"])
