+class StopFixRetest(_Env):
+    def test_failure_is_recorded_fixed_once_retested_without_restart_and_qualifies(self):
+        self.app("launch", executable=False)
+        self.stub_start(); self.watcher(self.launcher_decides)
+        r = self.job("launch")
+        self.assertEqual(r["handoff_state"], "QUALIFIED")
+        self.assertEqual(self.runs["launch"], 1)             # the app was NOT restarted for the retest
+        self.assertEqual(self.checks["launch"], 2)           # the check, then ONE retest
+        rep = r["repair"]
+        self.assertEqual(rep["status"], "RESOLVED")
+        c = rep["cycles"][0]
+        self.assertEqual((c["fix"]["tier"], c["fix"]["rule"]), (1, "qualify.launcher_not_executable"))
+        self.assertEqual([x["name"] for x in c["fix"]["applied"]], ["chmod_launcher"])     # the REAL action
+        self.assertNotEqual(c["fix"]["condition_before"], c["fix"]["condition_after"])
+        self.assertTrue(os.access(self.ar.app_dir("launch") / ".ui-capability" / "run-ui.sh", os.X_OK))
+        # The original failure is kept, with exactly where, and its own identity; the retest has its own.
+        rec = json.loads(Path(rep["first_failure"]).read_text())
+        self.assertEqual((rec["stage"], rec["code"], rec["class"]), ("1 INSTALLED", "NOT_EXECUTABLE", "OVERLAY_INSTALL"))
+        self.assertIn("is not executable", rec["error"])
+        self.assertEqual(r["failure"]["stage"], "1 INSTALLED")
+        self.assertNotEqual(rec["correlation_id"], c["retest"]["correlation_id"])
+        self.assertEqual(r["verification"]["correlation_id"], c["retest"]["correlation_id"])
+        self.assertEqual(r["verification"]["repair"], 1)
+        self.assertEqual(r["verification"]["status"], "CURRENT")     # the barrier holds on the post-fix revision
+        first_ev, retest_ev = rec["evidence"]["dir"], c["retest"]["evidence"]["dir"]
+        self.assertNotEqual(first_ev, retest_ev)
+        self.assertTrue(Path(first_ev).is_dir(), first_ev); self.assertTrue(Path(retest_ev).is_dir(), retest_ev)   # neither overwrote the other
+        self.assertTrue(Path(retest_ev).name.endswith("-r1"))
+        self.assertIn("launch", self.downs)                   # stopped after the cycle
+        self.assertTrue(r["levels"]["verified"])
+
