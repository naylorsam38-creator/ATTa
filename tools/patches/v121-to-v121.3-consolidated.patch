+"""Where an app failed, what it most likely means, what has to change and what must be retested.
+
+Everything here is read from the result the runner and the watcher produced; nothing is guessed. The
+classification is a table from the failure's own code (watcher) or rule (runner): a failure no row
+covers is HUMAN_REVIEW with "evidence insufficient", never a made-up cause.
+"""
+from __future__ import annotations
+import hashlib, re
+
+STAGES = ("1 INSTALLED", "2 APP_UP", "3 PROXY_UP", "4 SKIN", "5 HOOK", "6 CLEAN")
+
+# Runner rule (stage 2, how the app failed to start) -> (class, what needs to change)
+RULE_CLASS = {
+    "compose.required_var": ("CONFIG_MISSING_ENV", "give the variable the compose file requires a value"),
+    "app.env_required": ("CONFIG_MISSING_ENV", "give the variable the app asks for a value"),
+    "app.env_required2": ("CONFIG_MISSING_ENV", "give the variable the app asks for a value"),
+    "app.env_specify": ("CONFIG_MISSING_ENV", "give the variable the app asks for a value"),
+    "compose.env_file_missing": ("CONFIG_MISSING_FILE", "create the env file the compose file names"),
+    "app.needs_database": ("MISSING_COMPANION_SERVICE", "start the database / cache the app connects to with it (a compose part that includes it)"),
+    "app.dependency_not_ready": ("MISSING_COMPANION_SERVICE", "let the app's dependency finish starting before the app (dependency health / start order)"),
+    "container.missing_path": ("MOUNT_OR_PATH", "provide the path the container expects (volume / config file)"),
+    "container.caps": ("CONTAINER_PERMISSIONS", "start with the kernel capability the app needs"),
+    "server.rlimit": ("CONTAINER_PERMISSIONS", "start without the ulimit the host refuses"),
+    "build.failed": ("BUILD_FAILED", "fix the image build (the failing build step is in the log excerpt)"),
+    "image.missing": ("IMAGE_NOT_FOUND", "use an image that exists in the registry, or build it"),
+    "image.arch": ("IMAGE_WRONG_ARCH", "use an image built for this CPU"),
+    "app.oom": ("OUT_OF_MEMORY", "give the app more memory, or start fewer apps at once"),
+    "disk.full": ("HOST_RESOURCES", "free disk space on the host"),
+    "host.memory": ("HOST_RESOURCES", "free memory on the host"),
+    "registry.rate_limit": ("REGISTRY_RATE_LIMIT", "registry mirror / Docker Hub login"),
+    "port.clash": ("PORT_CLASH", "free or change the host port"),
+    "host.no_ipv6": ("HOST_CONFIG", "enable IPv6 on the host"),
+    "compose.invalid": ("COMPOSE_INVALID", "fix the compose file"),
+    "cli.needs_command": ("WRONG_ENTRYPOINT", "start the app's server subcommand"),
+    "app.host_rejected": ("HOST_HEADER_REJECTED", "allow the proxy host in the app's allowed-hosts setting"),
+    "app.no_page": ("NO_WEB_UI", "this part serves no page: another part, or check it as a service"),
+    "container.exited": ("CONTAINER_EXITED", "read the container log excerpt: the process exits on start"),
+    "app.stalled": ("START_TIMEOUT", "the app stopped printing and never answered: read the log excerpt"),
+    "app.still_starting": ("START_TIMEOUT", "the app never answered within the boot timeout"),
+    "budget.spent": ("START_TIMEOUT", "the per-app time budget ran out"),
+    "unrecognised": ("HUMAN_REVIEW", "evidence insufficient: no rule recognises this failure; read the log excerpt"),
+}
+
+# Watcher code (stages 1, 3-6) -> (class, what needs to change). Prefix match, first wins.
+CODE_CLASS = [
+    ("DEPLOYMENT_CHANGED", "REVISION_CHANGED", "nothing in the app: re-run against the current revision"),
+    ("RUNNER_EXCEPTION", "ATTA_INTERNAL", "ATTa itself raised: fix the traceback in ATTa, not the app"),
+    ("WORKER_", "ATTA_INTERNAL", "ATTa's job for this app crashed or hung: see the event and traceback"),
+    ("WATCHER_EXCEPTION", "ATTA_INTERNAL", "the watcher raised: fix the traceback in ATTa"),
+    ("PLAYWRIGHT_UNAVAILABLE", "ATTA_ENVIRONMENT", "install the browser stage 6 needs"),
+    ("RUNNER_NO_DOCKER", "ATTA_ENVIRONMENT", "Docker must run on the host"),
+    ("RUNNER_NO_RECIPE", "NO_WAY_TO_RUN", "the app ships no compose file, image or Dockerfile: give it one"),
+    ("RUNNER_HOST_NO_IPV6", "HOST_CONFIG", "enable IPv6 on the host"),
+    ("PROXY_NOT_STARTED", "SKIN_PROXY", "the skin proxy (run-ui.sh) did not start: read its error"),
+    ("FILE_MISSING", "OVERLAY_INSTALL", "reinstall the app's .ui-capability overlay"),
+    ("NOT_EXECUTABLE", "OVERLAY_INSTALL", "make run-ui.sh executable"),
+    ("BAD_JSON", "OVERLAY_INSTALL", "repair the overlay JSON"),
+    ("UNREACHABLE", "APP_NOT_ANSWERING", "the app or its proxy stopped answering after start"),
+    ("TIMEOUT", "APP_NOT_ANSWERING", "the app or its proxy answered too slowly"),
+    ("UPSTREAM_5", "APP_SERVER_ERROR", "the app answers 5xx: read its log excerpt (backend/database not ready or crashing)"),
+    ("HTTP_", "APP_HTTP_ERROR", "the app answers an error status through the proxy"),
+    ("NOT_HTML", "NO_WEB_UI", "the page is not HTML: check it as a service, or open its web UI path"),
+    ("REDIRECT", "REDIRECT_OFF_PROXY", "set the app's base URL / single-domain setting to the proxy address"),
+    ("PORT_REDIRECT", "REDIRECT_OFF_PROXY", "set the app's base URL to the proxy address"),
+    ("NO_HEAD", "SKIN_INJECTION", "the page has no <head> for the skin link: the proxy cannot inject"),
+    ("NO_LINK", "SKIN_INJECTION", "the skin <link> is not in the page the proxy serves (injection did not happen on this page)"),
+    ("DUPLICATE_", "SKIN_INJECTION", "the skin/hook is injected more than once"),
+    ("LINK_AFTER_HEAD", "SKIN_INJECTION", "the skin link lands after </head>"),
+    ("TAG_AFTER_HEAD", "SKIN_INJECTION", "the hook tag lands after </head>"),
+    ("NO_TAG", "SKIN_INJECTION", "the capability hook <script> is not in the page"),
+    ("CSS_", "SKIN_ASSET", "the skin CSS is missing, empty or differs from the package: reinstall the overlay"),
+    ("NOT_CSS", "SKIN_ASSET", "the skin CSS is served with the wrong type"),
+    ("PORT_", "CAPABILITY_PORT", "the capability port script is missing, wrong or redirected: reinstall the overlay"),
+    ("NOT_JAVASCRIPT", "CAPABILITY_PORT", "the capability port script is served with the wrong type"),
+    ("BROWSER_HTTP", "APP_SERVER_ERROR", "the real browser got an error status: read the app log excerpt"),
+    ("REQUEST_FAILED", "BROWSER_REQUEST_FAILED", "requests the page makes fail (see request_failures: absolute URLs, CORS, missing assets)"),
+    ("PAGE_ERROR", "BROWSER_PAGE_ERROR", "the page throws JavaScript errors in the browser (see page_errors)"),
+    ("CSS_FAILED_TO_LOAD", "SKIN_ASSET", "the browser could not load the skin CSS"),
+    ("EMPTY_BODY", "BROWSER_EMPTY_PAGE", "the page renders nothing in the browser"),
+    ("BROWSER_", "BROWSER_CHECK", "the browser stage saw a skin/hook count or exception problem"),
+    ("ADAPTER_", "CAPABILITY_ADAPTER", "the capability adapter's state differs from what the app should show"),
+    ("JOURNEY_NOT_AUTHORED", "JOURNEY_NOT_AUTHORED", "author a login/smoke journey for this app (account strategy)"),
+    ("JOURNEY_", "JOURNEY_CONFIG", "fix the app's journey contract"),
+    ("TEST_ACCOUNT_MISSING", "JOURNEY_ACCOUNT", "create the test account the journey uses"),
+    ("LOGIN_", "JOURNEY_LOGIN", "the login journey failed at the step named: check the account and the post-login expectation"),
+    ("SMOKE_", "JOURNEY_SMOKE", "the smoke journey failed at the step named"),
+    ("TOOLCHAIN_TOO_OLD", "TOOLCHAIN", "the app needs a newer toolchain than the host has"),
+    ("NO_INTAKE_RECORD", "INTAKE", "the app has no intake record: run intake"),
+    ("RUNNER_EXHAUSTED", None, None),   # resolved from the runner's last rule
+]
+
+# What must be retested once the cause is changed: the failed stage and every stage after it; the stages
+# before it are re-checked too (read-only, seconds) because the watcher always walks 1 -> 6, which is the
+# regression check that the change did not break what already passed. A change to how the app STARTS
+# (stage 2 classes) means the app itself is restarted.
+RESTART_CLASSES = {"CONFIG_MISSING_ENV", "CONFIG_MISSING_FILE", "MISSING_COMPANION_SERVICE", "MOUNT_OR_PATH",
+                   "CONTAINER_PERMISSIONS", "BUILD_FAILED", "IMAGE_NOT_FOUND", "IMAGE_WRONG_ARCH", "OUT_OF_MEMORY",
+                   "HOST_RESOURCES", "REGISTRY_RATE_LIMIT", "PORT_CLASH", "HOST_CONFIG", "COMPOSE_INVALID",
+                   "WRONG_ENTRYPOINT", "HOST_HEADER_REJECTED", "NO_WEB_UI", "CONTAINER_EXITED", "START_TIMEOUT",
+                   "NO_WAY_TO_RUN", "REDIRECT_OFF_PROXY", "APP_SERVER_ERROR"}
+
+
+def _last_rule(r: dict) -> dict:
+    attempts = (r.get("runner") or {}).get("attempts") or []
+    failed = [a for a in attempts if a.get("rule")]
+    return failed[-1] if failed else {}
+
+
+def classify(r: dict) -> tuple[str, str]:
+    code = str(r.get("code") or "")
+    for prefix, cls, change in CODE_CLASS:
+        if code.startswith(prefix):
+            if cls is None:
+                break
+            return cls, change
+    last = _last_rule(r)
+    rule = last.get("rule") or ("unrecognised" if code == "RUNNER_EXHAUSTED" else None)
+    if rule and rule in RULE_CLASS:
+        cls, change = RULE_CLASS[rule]
+        return cls, change
+    return "HUMAN_REVIEW", "evidence insufficient: no classification covers this failure code; read the evidence"
+
+
+def norm(text: str) -> str:
+    """A failure's text without what changes between two identical failures (times, ports, ids, paths)."""
+    t = re.sub(r"(/[\w.\-]+)+", "<path>", str(text or ""))
+    t = re.sub(r"\b[0-9a-f]{8,}\b", "<id>", t)
+    t = re.sub(r"\d+", "#", t)
+    return re.sub(r"\s+", " ", t).strip()[:600]
+
+
+def signature(r: dict) -> str:
+    """Same signature = the same failure: same stage, same code, same (normalised) detail."""
+    st = r.get("broken_at") or ""
+    d = ((r.get("stages") or {}).get(st) or {}).get("detail") or ""
+    last = _last_rule(r)
+    raw = f"{st}|{r.get('code')}|{norm(d)}|{last.get('rule') or ''}|{norm(last.get('evidence') or '')[:300]}"
+    return hashlib.sha256(raw.encode()).hexdigest()[:16]
+
+
+def location(r: dict) -> dict:
+    """Exactly where: the stage, the code, and for a start failure which way of running it, which attempt
+    and which rule; for a browser failure the URL the browser was on and the journey step."""
+    st = r.get("broken_at")
+    sd = (r.get("stages") or {}).get(st) or {}
+    loc = {"stage": st, "code": r.get("code"), "detail": str(sd.get("detail") or "")[:2000]}
+    last = _last_rule(r)
+    if last:
+        loc.update({"part": last.get("part"), "attempt": last.get("n"), "rule": last.get("rule"), "fix_tried": last.get("fix")})
+    s6 = (r.get("stages") or {}).get("6 CLEAN") or {}
+    j = s6.get("journey") or {}
+    if st == "6 CLEAN" and j:
+        loc.update({"journey_type": j.get("type"), "journey_step": j.get("step") or j.get("code"),
+                    "journey_detail": str(j.get("detail") or "")[:600]})
+    ev = s6.get("evidence") or {}
+    if st == "6 CLEAN" and ev.get("browser"):
+        loc["browser_evidence"] = ev.get("browser")
+    return loc
+
+
+def retest_plan(cls: str, stage: str | None) -> dict:
+    after = [s for s in STAGES if stage and STAGES.index(s) >= STAGES.index(stage)] if stage in STAGES else list(STAGES)
+    before = [s for s in STAGES if s not in after]
+    restart = cls in RESTART_CLASSES or stage == "2 APP_UP"
+    return {"retest": after, "regression": before, "restart_app": restart,
+            "note": ("restart the app with the change, then " if restart else "app stays up; ")
+                    + f"re-run {', '.join(after)}" + (f"; re-check {', '.join(before)} (regression)" if before else "")}
diff --git a/04-deployment/resilience/identity.py b/04-deployment/resilience/identity.py
new file mode 100644
index 0000000..00ee762
--- /dev/null
+++ b/04-deployment/resilience/identity.py
@@ -0,0 +1,128 @@
+from __future__ import annotations
+import hashlib, json, secrets, time
+from pathlib import Path
+
+# The code folder this module runs from (04-deployment). Under Coolify it is /opt/atta/04-deployment inside
+# the image; on a plain server it is the folder systemd starts from. It is the code actually executing.
+CODE_DIR = Path(__file__).resolve().parents[1]
+# Code that decides a verdict. A change to any of these files is a new deployment revision.
+_CODE_GLOBS = ("*.py", "resilience/*.py", "deployd/**/*.py", "upstream_apps.json", "app_catalogue.json")
+
+
+def code_revision(code_dir: Path | str | None = None) -> str:
+    """Content identity of the running ATTa code: release.json next to the code folder plus every file
+    that decides a verdict. v121.1 looked only under APP_BUILDER_ROOT for release.json; inside the Coolify
+    container nothing is ever put there, so every app read "unknown" and was marked UNVERIFIED."""
+    code_dir = Path(code_dir) if code_dir else CODE_DIR
+    h = hashlib.sha256()
+    seen = 0
+    rel = code_dir.parent / "release.json"
+    files = [rel] if rel.is_file() else []
+    for g in _CODE_GLOBS:
+        files += sorted(p for p in code_dir.glob(g) if p.is_file() and "__pycache__" not in p.parts)
+    for p in dict.fromkeys(files):
+        try:
+            data = p.read_bytes()
+        except OSError:
+            continue
+        name = "release.json" if p == rel else p.relative_to(code_dir).as_posix()
+        h.update(name.encode() + b"\0" + hashlib.sha256(data).digest())
+        seen += 1
+    return "code:" + h.hexdigest()[:24] if seen else "unknown"
+
+
+def deployment_revision(root: Path | str, code_dir: Path | str | None = None) -> str:
+    """Stable identity for the currently deployed ATTa: the ADM-promoted release (when ADM manages this
+    machine) plus the content of the code that is actually running. Never "unknown" while the running
+    code can be read, so a missing release.json can't turn every verdict into UNVERIFIED."""
+    root = Path(root)
+    candidates = [root / "adm" / "current" / "release.json", root / "current" / "release.json", root / "app" / "release.json", root / "release.json"]
+    release = None
+    for p in candidates:
+        try:
+            if p.is_file():
+                release = json.loads(p.read_text())
+                break
+        except (OSError, ValueError, json.JSONDecodeError):
+            continue
+    parts = []
+    if release is not None:
+        raw = json.dumps(release, sort_keys=True, separators=(",", ":")).encode()
+        parts.append("release:" + hashlib.sha256(raw).hexdigest()[:24])
+    else:
+        try:
+            cur = root / "adm" / "current"
+            parts.append("path:" + str(cur.resolve(strict=True)))
+        except OSError:
+            pass
+    code = code_revision(code_dir)
+    if code != "unknown":
+        parts.append(code)
+    return "+".join(parts) or "unknown"
+
+
+def _git_head(d: Path) -> str | None:
+    """HEAD commit read from the repository files (no subprocess: this runs twice per app per check)."""
+    g = d / ".git"
+    try:
+        if g.is_file():   # worktree / submodule: "gitdir: <path>"
+            txt = g.read_text().strip()
+            if txt.startswith("gitdir:"):
+                g = (d / txt.split(":", 1)[1].strip()).resolve()
+        head = (g / "HEAD").read_text().strip()
+        if not head.startswith("ref:"):
+            return head or None
+        ref = head.split(":", 1)[1].strip()
+        if (g / ref).is_file():
+            return (g / ref).read_text().strip() or None
+        packed = g / "packed-refs"
+        if packed.is_file():
+            for line in packed.read_text().splitlines():
+                if line.endswith(" " + ref):
+                    return line.split(" ", 1)[0]
+        return "unborn:" + ref
+    except OSError:
+        return None
+
+
+def app_revision(app_dir: Path | str) -> str:
+    """Identity of ONE app as it is being tested: its source commit, the intake record of every change
+    made to it, and the skin/port files stages 4 and 5 compare against. Deliberately not a whole-tree
+    fingerprint: the runner creates .env files in the app folder while starting it, and that must not
+    read as "the app changed under the check". A re-import (new commit, new intake) or a new skin does."""
+    d = Path(app_dir)
+    if not d.is_dir():
+        return "missing"
+    h = hashlib.sha256()
+    head = _git_head(d)
+    h.update(b"head\0" + (head or "none").encode())
+    try:
+        h.update(b"intake\0" + hashlib.sha256((d / ".atta-intake.json").read_bytes()).digest())
+    except OSError:
+        h.update(b"intake\0none")
+    ui = d / ".ui-capability"
+    if ui.is_dir():
+        for p in sorted(x for x in ui.rglob("*") if x.is_file()):
+            try:
+                h.update(p.relative_to(ui).as_posix().encode() + b"\0" + hashlib.sha256(p.read_bytes()).digest())
+            except OSError:
+                h.update(p.relative_to(ui).as_posix().encode() + b"\0unreadable")
+    return "app:" + h.hexdigest()[:24] + (":" + head[:12] if head else "")
+
+
+def new_correlation_id() -> str:
+    return "c-" + secrets.token_hex(8)
+
+
+def verification_snapshot(root: Path | str, app: str, attempt: int = 1, app_dir: Path | str | None = None) -> dict:
+    return {
+        "deployment_revision": deployment_revision(root),
+        "app_revision": app_revision(app_dir) if app_dir is not None else None,
+        "app": str(app),
+        "attempt": int(attempt),
+        "captured_at": time.time(),
+    }
+
+
+def revision_stable(before: str, after: str) -> bool:
+    return bool(before and after and before != "unknown" and before == after)
