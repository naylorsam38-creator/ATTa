new file mode 100644
index 0000000..8d9e52b
--- /dev/null
+++ b/04-deployment/atta_control/store.py
@@ -0,0 +1,39 @@
+from __future__ import annotations
+import hashlib,json,os,time
+from pathlib import Path
+from typing import Any,Mapping
+
+def canonical_json_bytes(value:Any)->bytes:
+    return json.dumps(value,sort_keys=True,separators=(",",":"),ensure_ascii=False,allow_nan=False).encode()
+def sha256_bytes(data:bytes)->str: return hashlib.sha256(data).hexdigest()
+def fingerprint(value:Any)->str: return sha256_bytes(canonical_json_bytes(value))
+
+def append_jsonl(path:Path,event:Mapping[str,Any])->None:
+    path.parent.mkdir(parents=True,exist_ok=True)
+    line=canonical_json_bytes(event)+b"\n"
+    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_APPEND,0o600)
+    try:
+        if os.write(fd,line)!=len(line): raise OSError("Incomplete audit append")
+        os.fsync(fd)
+    finally: os.close(fd)
+
+class EventStore:
+    def __init__(self,root:Path): self.root=Path(root)
+    def app_attempt_dir(self,app:str,run_id:str,attempt:int)->Path:
+        safe_app="".join(c for c in str(app) if c.isalnum() or c in "-_.")
+        safe_run="".join(c for c in str(run_id) if c.isalnum() or c in "-_.")
+        if not safe_app or not safe_run or attempt<1: raise ValueError("Invalid app/run/attempt identity")
+        p=self.root/safe_app/f"{safe_run}-a{attempt}"
+        p.mkdir(parents=True,exist_ok=True)
+        return p
+    def append_observation(self,event): append_jsonl(self.root/"observations.jsonl",event)
+    def append_audit(self,event): append_jsonl(self.root/"repair-audit.jsonl",event)
+    def append_run_event(self,event): append_jsonl(self.root/"run-events.jsonl",event)
+    @staticmethod
+    def evidence_file_digest(path:Path)->str:
+        d=hashlib.sha256()
+        with Path(path).open("rb") as f:
+            for chunk in iter(lambda:f.read(1024*1024),b""): d.update(chunk)
+        return d.hexdigest()
+    @staticmethod
+    def now(): return time.time()
