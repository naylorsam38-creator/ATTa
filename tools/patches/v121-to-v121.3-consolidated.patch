+"""ATTa additive control layer.
+
+This package adds identity, evidence, policy, authorization, audit, and reporting
+around the existing ATTa runner/repair/deploy machinery. It does not launch apps
+or replace any existing repair action.
+"""
+from .models import Outcome, Stage, DeploymentState, AppIdentity, EvidenceRef, Observation, RepairAuthorization, AppRun
+from .policy import Action, PolicyDecision, RepairPolicy
+from .store import EventStore
+from .gate import RepairDenied, execute_existing_repair
+
+__all__ = [
+    "Outcome","Stage","DeploymentState","AppIdentity","EvidenceRef","Observation",
+    "RepairAuthorization","AppRun","Action","PolicyDecision","RepairPolicy",
+    "EventStore","RepairDenied","execute_existing_repair",
+]
