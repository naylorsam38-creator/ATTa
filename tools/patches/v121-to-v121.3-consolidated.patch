+# ------------------------------------------------------------------ v121.3: stop, record, one bounded fix, retest
+# TEST -> FAIL -> STOP THAT APP -> RECORD EXACTLY WHERE -> CLASSIFY -> ONE BOUNDED FIX (ATTa's own repair tiers:
+# known fixes, then the capability adapter) -> RETEST THE FAILED STAGE (+ the earlier stages as regression)
+# -> same failure = the fix did not resolve it, stop; passes = continue to the final barrier; a different
+# failure = record it and repeat, at most REPAIR_CYCLES times, never the same fix twice for the same failure.
+# There is no blind retry: a failure no tier has an evidence-based fix for stops the app and is reported for
+# the next repair decision. Every failure, fix and retest has its own record, evidence and revision identity.
+REPAIR_CYCLES = int(os.environ.get("APP_BUILDER_REPAIR_CYCLES", "3"))
+FAILURES = RUNNER / "failures"
+# Repairs whose effect is not limited to one app. After one is applied, apps that already qualified before
+# it are checked again at the end of the run (the regression check it needs).
+SHARED_ACTIONS = {"install_browser", "add_runner_rule"}
+_NOT_HERE = {"ATTA_INTERNAL", "REVISION_CHANGED"}
