+from __future__ import annotations
+from dataclasses import asdict, dataclass, field
+from enum import Enum
+from typing import Any, Mapping, Optional
+
+class Outcome(str, Enum):
+    START_FAILED="START_FAILED"; TIMEOUT="TIMEOUT"; INCONCLUSIVE="INCONCLUSIVE"
+    FAILED="FAILED"; QUALIFIED="QUALIFIED"; UNVERIFIED="UNVERIFIED"
+
+class Stage(str, Enum):
+    DISCOVERY="DISCOVERY"; PREFLIGHT="PREFLIGHT"; BUILD="BUILD"; STARTUP="STARTUP"
+    HEALTH="HEALTH"; BROWSER="BROWSER"; REPAIR="REPAIR"; RETEST="RETEST"
+    DEPLOY="DEPLOY"; LIVE_VERIFY="LIVE_VERIFY"; CLEANUP="CLEANUP"
+
+class DeploymentState(str, Enum):
+    NOT_REQUESTED="NOT_REQUESTED"; DISPATCHED="DISPATCHED"; DEPLOYING="DEPLOYING"
+    RUNNING="RUNNING"; VERIFIED="VERIFIED"; FAILED="FAILED"; UNKNOWN="UNKNOWN"
+
+@dataclass(frozen=True)
+class AppIdentity:
+    app: str
+    run_id: str
+    attempt: int
+    correlation_id: str
+    app_revision: Optional[str]
+    deployment_revision: Optional[str]=None
+
+@dataclass(frozen=True)
+class EvidenceRef:
+    path: str
+    sha256: str
+    source: str
+    stage: Stage
+    timestamp: float
+
+@dataclass(frozen=True)
+class Observation:
+    identity: AppIdentity
+    stage: Stage
+    timestamp: float
+    source: str
+    result: str
+    summary: str
+    raw_evidence: tuple[EvidenceRef,...]=()
+    details: Mapping[str,Any]=field(default_factory=dict)
+
+@dataclass(frozen=True)
+class RepairAuthorization:
