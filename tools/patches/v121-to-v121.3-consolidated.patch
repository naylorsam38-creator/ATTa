+def _unique(path: Path) -> Path:
+    """Never overwrite a record: <name>.json, <name>-2.json, ..."""
+    if not path.exists():
+        return path
+    i = 2
+    while path.with_name(f"{path.stem}-{i}{path.suffix}").exists():
+        i += 1
+    return path.with_name(f"{path.stem}-{i}{path.suffix}")
+
