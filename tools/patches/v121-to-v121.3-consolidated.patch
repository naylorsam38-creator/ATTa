+        if fix is None:
+            status = entry["outcome"] = "NO_MATCHING_REPAIR"
+            entry["next"] = "next repair decision needed (no evidence-based fix in ATTa's repair tiers): " + fail["what_to_change"]
+            log(f"[{a}] stopped: no evidence-based repair for {fail['stage']} {fail['code']}; reported for the next repair decision")
+            break
+        entry["fix"] = {x: fix.get(x) for x in ("tier", "rule", "findings", "actions", "human")}
+        if fix.get("human"):
