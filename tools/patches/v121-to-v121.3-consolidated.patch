+                     "stage_6": (r.get("stages") or {}).get("6 CLEAN")}
+    r["verdict"] = "UNVERIFIED"
+    r["broken_at"] = r.get("broken_at") or "6 CLEAN"
+    r["code"] = code
+    r.setdefault("stages", {})["6 CLEAN"] = {"status": "FAIL", "code": code,
+                                             "detail": detail + "; rerun against the current revision"}
+    r["handoff_state"] = handoff_state(r)
+    r["levels"] = levels(r)
