+def _invalidate(r: dict, code: str, detail: str) -> None:
+    """The checks ran against a revision that is no longer the one being verified: nothing they saw may
+    stand as qualification evidence for the current one."""
+    v = r.setdefault("verification", {})
+    v["status"] = "UNVERIFIED"
