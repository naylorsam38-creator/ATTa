+from __future__ import annotations
+import os,time,uuid
+from dataclasses import asdict
+from typing import Any,Iterable,Protocol
+from .models import AppIdentity,Observation,Stage,DeploymentState
+from .store import EventStore
+
+def _first(d,*keys,default=None):
+    for k in keys:
+        v=d.get(k) if isinstance(d,dict) else None
+        if v not in (None,""): return v
+    return default
+
+def identity_from_record(rec:dict,item:dict|None=None)->AppIdentity:
+    item=item or {}
+    v=item.get("verification") or rec.get("verification") or {}
+    app=_first(item,"app",default=rec.get("app","fleet"))
+    run_id=_first(v,"run_id","correlation_id",default=rec.get("id","unknown-run"))
+    corr=_first(v,"correlation_id","run_id",default=run_id)
+    attempt=int(_first(v,"attempt",default=1) or 1)
+    app_rev=_first(v,"app_revision",default=None) or _first(item,"app_revision",default=None)
+    dep_rev=_first(v,"deployment_revision",default=None)
+    return AppIdentity(str(app),str(run_id),attempt,str(corr),str(app_rev) if app_rev else None,
+                       str(dep_rev) if dep_rev else None)
+
+def evidence_from_record(rec:dict,item:dict|None=None)->dict:
+    item=item or {}
+    return {"timestamp":float(_first(item,"timestamp",default=rec.get("updated",rec.get("created",time.time()))) or time.time()),
+            "app":item.get("app"),"stage":item.get("broken_at"),"code":item.get("code"),
+            "detail":str(item.get("detail") or item.get("error") or "")[:2000],
+            "record_updated":rec.get("updated")}
+
+class ExistingATTa(Protocol):
+    def discover_apps(self)->Iterable[Any]: ...
+    def enqueue_all_parallel(self,apps:Iterable[Any])->Any: ...
+    def collect_run_events(self,run_handle:Any)->Iterable[Any]: ...
+    def wait_for_completion(self,run_handle:Any)->None: ...
+    def qualified_apps(self,run_handle:Any)->Iterable[Any]: ...
+    def deploy_to_coolify(self,app_result:Any)->Any: ...
+    def verify_coolify_deployment(self,deployment:Any)->Any: ...
+    def rerun_affected(self,app_identities:Iterable[AppIdentity])->Any: ...
+
+def normalize_observation(raw:Any)->Observation:
+    if not isinstance(raw,dict): raise ValueError("ATTa event is not a mapping")
+    identity=identity_from_record(raw,raw)
+    stage_name=str(raw.get("stage") or "DISCOVERY")
+    try: stage=Stage(stage_name)
+    except ValueError: stage=Stage.DISCOVERY
+    return Observation(identity,stage,float(raw.get("timestamp",time.time())),str(raw.get("source","ATTa")),
+        str(raw.get("result","INCONCLUSIVE")),str(raw.get("summary") or raw.get("detail") or ""),
+        tuple(),dict(raw))
+
+def run_existing_atta(adapter:ExistingATTa,store:EventStore)->dict:
+    apps=list(adapter.discover_apps()); handle=adapter.enqueue_all_parallel(apps); adapter.wait_for_completion(handle)
+    obs=[]
+    for raw in adapter.collect_run_events(handle):
+        o=normalize_observation(raw); obs.append(o); store.append_observation(asdict(o))
+    return {"run_handle":handle,"discovered_count":len(apps),"observations":obs}
+
+def deploy_individually_qualified(adapter:ExistingATTa,run_handle,store:EventStore)->list[dict]:
+    results=[]
+    for app_result in adapter.qualified_apps(run_handle):
+        item={"identity":None,"state":DeploymentState.UNKNOWN.value}
+        ident=getattr(app_result,"identity",None)
+        if ident: item["identity"]=asdict(ident)
+        try:
+            dep=adapter.deploy_to_coolify(app_result); item["state"]=DeploymentState.DISPATCHED.value
+            item["deployment_result"]=adapter.verify_coolify_deployment(dep)
+            item["state"]=DeploymentState.VERIFIED.value
+        except Exception as exc:
+            item.update(state=DeploymentState.FAILED.value,error_type=type(exc).__name__,error=str(exc))
+        store.append_run_event({"event":"COOLIFY_RESULT","result":item}); results.append(item)
+    return results
