+"""v121.3: TEST -> FAIL -> STOP THAT APP -> RECORD EXACTLY WHERE -> ONE BOUNDED FIX (ATTa's own repair tiers)
+-> RETEST THE FAILED STAGE -> REGRESSION -> CONTINUE -> FINAL VERIFICATION, with no blind retries.
+
+The runner, its repair cycle, known_fixes, the capability adapter, repair_actions (the REAL chmod_launcher etc.),
+the failure records, the report and maintenance run for real. Only what needs a Docker host is stood in:
+run_app / start_proxy / down, and the watcher's check, which here reads the real app files on disk (is the
+launcher executable? is the flag there?) so a real repair really changes what the next check sees.
+Run: python3 -m pytest -q tests/test_v121_3_stop_fix_retest.py
+"""
+import importlib, json, os, shutil, sys, tempfile, threading, time, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent.parent
+DEP = HERE / "04-deployment"
+sys.path.insert(0, str(DEP))
+sys.path.insert(0, str(HERE / "tests"))
+
+from test_v121_2_parallel_isolation import MODULES, make_app  # noqa: E402
+
+MODS = MODULES + ("repair_actions", "capability_adapter", "failure_keys", "alerts", "llm_repair", "syntax_triage")
+STAGES = ("1 INSTALLED", "2 APP_UP", "3 PROXY_UP", "4 SKIN", "5 HOOK", "6 CLEAN")
+
+
+class _Env(unittest.TestCase):
+    def setUp(self):
+        # Put back, after the test, the modules and environment this harness replaces: other test files (e.g.
+        # test_v117_coolify) imported the same modules against their own APP_BUILDER_ROOT at collection time.
+        self._saved_mods = {m: sys.modules.get(m) for m in MODS}
+        self._saved_env = {k: os.environ.get(k) for k in ("APP_BUILDER_ROOT", "APP_BUILDER_SESSION_SECRET",
+                                                          "PLAYWRIGHT_BROWSERS_PATH")}
+        self.root = Path(tempfile.mkdtemp())
+        os.environ["APP_BUILDER_ROOT"] = str(self.root)
+        os.environ["APP_BUILDER_SESSION_SECRET"] = "x"
+        os.environ["PLAYWRIGHT_BROWSERS_PATH"] = str(self.root / "pw")
+        for m in MODS:
+            sys.modules.pop(m, None)
+        self.ar = importlib.import_module("app_runner")
+        self.w = importlib.import_module("system_watcher")
+        self.ar.START_FREE_MEMORY = 0.0; self.ar.START_FREE_DISK_GB = 0.0
+        self.ar._POOL_POLL = 0.05; self.ar._GATE_POLL = 0.05
+        self.ar.WARMUP_RECHECK_WAIT = 0
+        self.ar.sh = lambda *a, **k: (0, "")
+        self.downs = []
+        self.ar.down = lambda app, prune=None: self.downs.append(app) or "stopped"
+        self.ar._logs = lambda app, part, tail=200: f"container log of {app}: ERROR something real\n"
+        self.runs = {}
+        self.checks = {}
+        self.logs = []
+
+    def tearDown(self):
+        shutil.rmtree(self.root, ignore_errors=True)
+        for k, v in self._saved_env.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+        for m, mod in self._saved_mods.items():
+            if mod is None:
+                sys.modules.pop(m, None)
+            else:
+                sys.modules[m] = mod
+
+    # --- the Docker stand-ins -------------------------------------------------------------------
+    def app(self, name, executable=True):
+        d = make_app(self.ar.LIB, name, qualification="service")
+        (d / ".ui-capability" / "run-ui.sh").chmod(0o755 if executable else 0o644)
+        return d
+
+    def stub_start(self):
+        def run_app(app, log=print):
+            self.runs[app] = self.runs.get(app, 0) + 1
+            return {"ok": True, "url": "http://127.0.0.1:59999/", "part": {"why": "own image", "kind": "image"},
+                    "attempts": [{"n": 1, "part": "own image", "outcome": "UP"}]}
+        def start_proxy(app, url):
+            t = {"app": app, "target_url": url, "proxy_url": "http://127.0.0.1:59998",
+                 "ui_dir": str(self.ar.app_dir(app) / ".ui-capability")}
+            (self.ar.TARGETS / f"{self.ar.safe_id(app)}.json").write_text(json.dumps(t))
+            return True, "", t
+        self.ar.run_app = run_app
+        self.ar.start_proxy = start_proxy
+        self.ar.safe_http_probe = lambda url, timeout=6: {"status": "PASS", "tcp_connected": True, "http_status": 200,
+                                                          "content_type": "application/json"}
+
+    def watcher(self, decide):
+        """decide(app, t) -> (failed_stage, code, detail) or None for a pass. Every call is counted and
+        captured as real stage-6 evidence into the job's own folder."""
+        outer = self
+        class W:
+            stage = staticmethod(outer.w.stage); fail = staticmethod(outer.w.fail); result = staticmethod(outer.w.result)
+            def check(inner, t):
+                app = t["app"]
+                outer.checks[app] = outer.checks.get(app, 0) + 1
+                ev = outer.w._capture(app, _Page(outer.checks[app]), [], [], [], metadata=t.get("_identity"))
+                d = decide(app, t)
+                st = {}
+                for s in STAGES:
+                    if d and s == d[0]:
+                        r = outer.w.fail(app, st, s, d[1], d[2])
+                        break
+                    st[s] = outer.w.stage()
+                else:
+                    r = outer.w.result(app, st)
+                r["stages"]["6 CLEAN"] = {**r["stages"].get("6 CLEAN", {}), "evidence": ev}
+                return r
+        self.ar._watcher = lambda: W()
+
+    def launcher_decides(self, app, t):
+        f = Path(t["ui_dir"]) / "run-ui.sh"
+        return None if os.access(f, os.X_OK) else ("1 INSTALLED", "NOT_EXECUTABLE", f"{f} is not executable")
+
+    def job(self, name):
+        return self.ar._qualify_one(name, self.logs.append)
+
