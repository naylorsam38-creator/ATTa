+from __future__ import annotations
+import json,time
+from pathlib import Path
+
+def write_json_report(path:Path,report:dict)->None:
+    path.parent.mkdir(parents=True,exist_ok=True); tmp=path.with_suffix(path.suffix+".tmp")
+    tmp.write_text(json.dumps(report,indent=2,sort_keys=True,ensure_ascii=False),encoding="utf-8"); tmp.replace(path)
+
+def write_markdown_report(path:Path,report:dict)->None:
+    rows=["# ATTa Run Report","",f"- Run ID: `{report.get('run_id','UNKNOWN')}`",
+          f"- Parallel mode: `{report.get('parallel_mode','UNKNOWN')}`",
+          f"- Total discovered apps: `{report.get('total_apps','UNKNOWN')}`","",
+          "## Applications","",
+          "| App | State | Attempts | Failure | Evidence | Coolify |","|---|---|---:|---|---|---|"]
+    for a in report.get("apps",[]):
+        rows.append("| {app} | {state} | {attempts} | {failure} | {evidence} | {coolify} |".format(
+            app=a.get("app","UNKNOWN"),state=a.get("final_state","UNKNOWN"),
+            attempts=a.get("attempt_count","UNKNOWN"),failure=a.get("failure_stage") or "—",
+            evidence=a.get("evidence_location") or "—",coolify=a.get("verification_state","UNVERIFIED")))
+    rows += ["","## Execution details",
+             f"- Configured resource cap: `{report.get('configured_resource_cap','UNKNOWN')}`",
+             f"- Peak concurrency: `{report.get('peak_concurrency','UNKNOWN')}`",
+             f"- Waits: `{report.get('waits','UNKNOWN')}`",
+             f"- Prunes: `{report.get('prunes','UNKNOWN')}`",
+             f"- Worker exceptions: `{report.get('worker_exceptions','UNKNOWN')}`",
+             f"- Timeouts: `{report.get('timeouts','UNKNOWN')}`",
+             f"- Late results: `{report.get('late_results','UNKNOWN')}`",""]
+    path.parent.mkdir(parents=True,exist_ok=True); path.write_text("\n".join(rows)+"\n",encoding="utf-8")
+
+def write_reports(report:dict,state_dir:Path)->None:
+    d=Path(state_dir)/"runner"; write_json_report(d/"RUN-REPORT.json",report)
+    write_markdown_report(d/"RUN-REPORT.md",report)
+    write_markdown_report(Path("ATTa-LIVE-RUN-REPORT.md"),report)
