+from __future__ import annotations
+import time
+from dataclasses import asdict
+from typing import Any,Callable,Mapping,Optional
+from .models import AppIdentity,RepairAuthorization
+from .policy import Action,RepairPolicy
+from .store import EventStore,fingerprint
+
+class RepairDenied(RuntimeError): pass
+
+def validate_identity(identity:AppIdentity):
+    e=[]
+    if not identity.app.strip(): e.append("missing app identity")
+    if not identity.run_id.strip(): e.append("missing run ID")
+    if identity.attempt<1: e.append("attempt must be >= 1")
+    if not identity.correlation_id.strip(): e.append("missing correlation ID")
+    if not identity.app_revision: e.append("missing app revision")
+    return e
+
+def authorize_repair(*,identity,evidence:Mapping[str,Any],classification:str,fix_name:str,
+                     remediation_id:Optional[str],policy:RepairPolicy,max_evidence_age_seconds:int,
+                     approval_granted:bool,store:EventStore)->RepairAuthorization:
+    reasons=validate_identity(identity)
+    ts=evidence.get("timestamp")
+    if not isinstance(ts,(int,float)): reasons.append("evidence timestamp missing or invalid")
+    else:
+        age=time.time()-float(ts)
+        if age>max_evidence_age_seconds: reasons.append("evidence is stale")
+        if age < -60: reasons.append("evidence timestamp is in the future")
+    if not remediation_id or not str(remediation_id).strip(): reasons.append("remediation_id is required")
+    decision=policy.decide(classification,fix_name)
+    if decision.action==Action.APPROVAL_REQUIRED and not approval_granted:
+        reasons.append("human approval required")
+    elif decision.action not in (Action.AUTO,Action.APPROVAL_REQUIRED):
+        reasons.append(f"policy action {decision.action.value} does not authorize execution")
+    auth=RepairAuthorization(not reasons,decision.action.value,decision.policy_version,remediation_id,
+                             tuple(reasons) if reasons else (decision.reason,))
+    store.append_audit({"event":"REPAIR_AUTHORIZATION","identity":asdict(identity),
+        "classification":classification,"fix_name":fix_name,"policy_version":decision.policy_version,
+        "action":decision.action.value,"remediation_id":remediation_id,
+        "evidence_fingerprint":fingerprint(evidence),"authorized":auth.allowed,
+        "reasons":list(auth.reasons),"timestamp":time.time()})
+    return auth
+
+def execute_existing_repair(*,identity,evidence,classification,fix_name,remediation_id,
+                            policy,store,existing_repair,approval_granted=False,
+                            max_evidence_age_seconds=3600,reread_evidence=None,enforce=True):
+    before=fingerprint(evidence)
+    auth=authorize_repair(identity=identity,evidence=evidence,classification=classification,
+        fix_name=fix_name,remediation_id=remediation_id,policy=policy,
+        max_evidence_age_seconds=max_evidence_age_seconds,approval_granted=approval_granted,store=store)
+    if enforce and not auth.allowed: raise RepairDenied("; ".join(auth.reasons))
+    if reread_evidence is not None:
+        latest=reread_evidence()
+        after=fingerprint(latest)
+        if after!=before:
+            store.append_audit({"event":"REPAIR_BLOCKED_EVIDENCE_CHANGED","identity":asdict(identity),
+                "remediation_id":remediation_id,"before_fingerprint":before,"after_fingerprint":after,
+                "timestamp":time.time()})
+            if enforce: raise RepairDenied("Evidence changed at authorization boundary")
+    store.append_audit({"event":"REPAIR_STARTED","identity":asdict(identity),"fix_name":fix_name,
+        "remediation_id":remediation_id,"policy_version":auth.policy_version,
+        "evidence_fingerprint":before,"enforced":bool(enforce),"timestamp":time.time()})
+    try: result=existing_repair()
+    except Exception as exc:
+        store.append_audit({"event":"REPAIR_EXCEPTION","identity":asdict(identity),"fix_name":fix_name,
+            "remediation_id":remediation_id,"exception_type":type(exc).__name__,"timestamp":time.time()})
+        raise
+    store.append_audit({"event":"REPAIR_RETURNED","identity":asdict(identity),"fix_name":fix_name,
+        "remediation_id":remediation_id,"timestamp":time.time()})
+    return result
