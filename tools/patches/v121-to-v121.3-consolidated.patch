+    detail = (f"the job was still running after {int(secs)}s (APP_BUILDER_APP_HARD_TIMEOUT={APP_HARD_TIMEOUT}s); "
+              "the fleet stopped waiting for it and stopped its containers")
+    log(f"[{a}] WORKER_TIMEOUT: {detail}")
+    _event("WORKER_TIMEOUT", a, detail, run_id=run_id, seconds=int(secs))
+    try:
