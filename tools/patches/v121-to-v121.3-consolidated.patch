+    r = _contained_failure(a, "WORKER_TIMEOUT", None, detail)
+    r.setdefault("verification", {}).update({"run_id": run_id, "status": "ABANDONED", "abandoned": True,
+                                             "fleet_run_id": _FLEET.get("fleet_run_id")})
