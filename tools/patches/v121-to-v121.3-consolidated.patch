+def _record_failure(a: str, r: dict, repair_n: int) -> dict:
+    """The failure exactly as it happened, kept forever (state/runner/failures/<app>/...). Written while the
+    app is still up, so the container log is the one that belongs to this failure."""
+    from resilience import failures as fx
+    k = safe_id(a)
+    job = getattr(_CTX, "job", None) or {}
+    cls, change = fx.classify(r)
+    loc = fx.location(r)
+    plan = fx.retest_plan(cls, r.get("broken_at"))
+    d = FAILURES / k
+    d.mkdir(parents=True, exist_ok=True)
+    base = f"{job.get('run_id') or 'norun'}-a{job.get('attempt') or 1}-f{repair_n}"
+    logs, log_file = "", None
+    part = (r.get("runner") or {}).get("part_detail")
+    if part and (r.get("runner") or {}).get("started"):
+        try:
+            logs = _logs(a, part, 300)
+        except Exception as e:
+            logs = f"(container log not readable: {type(e).__name__}: {e})"
+        log_file = _unique(d / f"{base}.container.log")
+        try:
+            log_file.write_text(logs)
+        except OSError:
+            log_file = None
+    now = time.time()
+    rec = {"app": k, "failure_no": repair_n, "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)), "at": now,
+           **{x: job.get(x) for x in _IDENTITY_KEYS}, "signature": fx.signature(r),
+           "stage": r.get("broken_at"), "code": r.get("code"), "location": loc, "class": cls, "what_to_change": change,
+           "retest": plan, "error": loc.get("detail"), "verdict": r.get("verdict"),
+           "start_attempts": [{k2: x.get(k2) for k2 in ("n", "part", "outcome", "rule", "fix", "evidence", "notes")}
+                              for x in (r.get("runner") or {}).get("attempts") or []],
+           "evidence": ((r.get("stages") or {}).get("6 CLEAN") or {}).get("evidence"),
+           "observations": r.get("observations"), "container_log_file": str(log_file) if log_file else None,
+           "container_log_tail": logs[-4000:] if logs else None, "stages": r.get("stages")}
+    path = _unique(d / f"{base}.json")
+    try:
+        tmp = path.with_suffix(".tmp"); tmp.write_text(json.dumps(rec, indent=2, default=str) + "\n"); os.replace(tmp, path)
+        rec["record"] = str(path)
+    except OSError as e:
+        rec["record"] = None; rec["record_error"] = str(e)
+    return rec
+
