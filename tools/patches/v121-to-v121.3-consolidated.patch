+class FleetKeepsGoing(_Env):
+    def test_other_apps_finish_while_one_is_in_repair(self):
+        self.app("fixme", executable=False)
+        for n in ("a", "b", "c"):
+            self.app(n)
+        self.stub_start()
+        def decide(app, t):
+            if app == "fixme":
+                time.sleep(0.4)
+                return self.launcher_decides(app, t)
+            return None
+        self.watcher(decide)
+        out = {r["app"]: r for r in self.ar.qualify_all(["fixme", "a", "b", "c"], log=self.logs.append)}
+        self.assertEqual({k: v["handoff_state"] for k, v in out.items()}, dict.fromkeys(("fixme", "a", "b", "c"), "QUALIFIED"))
+        done_fix = out["fixme"]["verification"]["finished_at"]
+        for n in ("a", "b", "c"):
+            self.assertLess(out[n]["verification"]["finished_at"], done_fix)
+        rep = self.ar.LAST_REPORT
+        self.assertEqual(rep["concurrency"]["peak"], 4)
+        [f] = rep["failure_report"]
+        self.assertEqual((f["app"], f["failed_stage"], f["classification"], f["state"]), ("fixme", "1 INSTALLED", "OVERLAY_INSTALL", "QUALIFIED"))
+        self.assertEqual(f["repairs"][0]["outcome"], "RESOLVED")
+        md = (self.ar.RUNNER / "RUN-REPORT.md").read_text()
+        for label in ("**Failed stage:**", "**Exact location:**", "**Error/output:**", "**Logs/evidence:**",
+                      "**Likely classification:**", "**What needs to change:**", "**What to retest:**", "**Repair 1:**"):
