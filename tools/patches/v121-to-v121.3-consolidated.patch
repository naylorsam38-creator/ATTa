+"""Compatibility bridge into the existing ATTa repair machinery.
+
+The bridge never selects a new repair engine. It authorizes/audits the exact
+action that existing maintenance.py or llm_repair.py is already about to run.
+Set ATTA_CONTROL_ENFORCE=1 to make the gate blocking; default is compatibility
+audit mode so an incomplete legacy record cannot silently disable self-healing.
+"""
+from __future__ import annotations
+import os,time,uuid
+from pathlib import Path
+from .adapter import identity_from_record,evidence_from_record
+from .gate import execute_existing_repair
+from .policy import Action,RepairPolicy
+from .store import EventStore
+
+def _store():
+    try:
+        import builds
+        return EventStore(Path(builds.ROOT)/"state"/"control")
+    except Exception:
+        return EventStore(Path(os.environ.get("APP_BUILDER_ROOT","/srv/app-builder"))/"state"/"control")
+
+def _policy(action_name:str,classification:str="repair")->RepairPolicy:
+    # Exact action/classification pairs are constructed only for actions already
+    # registered by repair_actions.py. Unknown actions remain ESCALATE.
+    return RepairPolicy("atta-control-v1",{(classification,action_name):Action.AUTO})
+
+def authorize_and_run(*,rec:dict,item:dict,layer:str,action_name:str,run_callable,
+                      evidence:dict|None=None,remediation_id:str|None=None):
+    evidence=evidence or evidence_from_record(rec,item)
+    ident=identity_from_record(rec,item)
+    if not remediation_id: remediation_id=f"{rec.get('id','run')}-{layer}-{uuid.uuid4().hex[:12]}"
+    enforce=os.environ.get("ATTA_CONTROL_ENFORCE","0").lower() in {"1","true","yes"}
+    return execute_existing_repair(identity=ident,evidence=evidence,classification=layer,
+        fix_name=action_name,remediation_id=remediation_id,policy=_policy(action_name,layer),
+        store=_store(),existing_repair=run_callable,approval_granted=False,
+        max_evidence_age_seconds=int(os.environ.get("ATTA_CONTROL_EVIDENCE_MAX_AGE","3600")),
+        enforce=enforce)
