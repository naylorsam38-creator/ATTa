+def _contained_failure(a: str, code: str, exc: BaseException | None, detail: str | None = None) -> dict:
+    """A crash or hang in one app's job, turned into that app's result (never the fleet's problem).
+    Built without the app's folder when it is gone, and without the watcher module if that is what broke."""
+    import traceback
+    tb = traceback.format_exc() if exc is not None else ""
+    text = detail or f"{type(exc).__name__}: {exc}"
+    body = text + ("\n" + tb[-2000:] if tb and tb.strip() != "NoneType: None" else "")
+    try:
+        r = _synth(a, code, body)
+    except Exception:
+        try:
+            r = _watcher().fail(safe_id(a), {}, "2 APP_UP", code, body)
+        except Exception:
+            r = {"app": safe_id(a), "verdict": f"BROKEN AT 2 APP_UP — {code}", "broken_at": "2 APP_UP", "code": code,
+                 "stages": {"2 APP_UP": {"status": "FAIL", "code": code, "detail": body}}, "ts": time.time()}
+    r["runner"] = {"started": False, "contained": code, "exception": text, "traceback": tb[-4000:] if tb else None}
+    if code != "RUNNER_EXCEPTION":
+        _event(code, a, text[:300])
+    return r
