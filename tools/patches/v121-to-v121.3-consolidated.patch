+def _condition(a: str) -> str:
+    """What a repair can change for this app: its overlay files and source identity, its target registration,
+    whether its skin proxy is listening, whether the launcher can run. Same value before and after a fix =
+    the fix changed nothing, so re-running the test would be a blind retry."""
+    import hashlib
+    h = hashlib.sha256(_app_revision_of(a).encode())
+    tp = TARGETS / f"{safe_id(a)}.json"
+    try:
+        t = json.loads(tp.read_text())
+        h.update(json.dumps({k: v for k, v in t.items() if k not in ("parked", "parked_at")}, sort_keys=True).encode())
+        port = int(str(t.get("proxy_url") or "").rsplit(":", 1)[1].strip("/")) if t.get("proxy_url") else None
+        h.update(b"proxy:" + (b"up" if port and port_open(port) else b"down"))
+        launcher = Path(t.get("ui_dir") or "") / "run-ui.sh"
+        h.update(b"x:" + (b"1" if launcher.is_file() and os.access(launcher, os.X_OK) else b"0"))
+    except (OSError, ValueError, IndexError):
+        h.update(b"no-target")
+    # Shared environment a repair can install (stage 6's browser).
+    pw = Path(os.environ.get("PLAYWRIGHT_BROWSERS_PATH") or Path.home() / ".cache" / "ms-playwright")
+    try:
+        h.update(b"pw:" + ",".join(sorted(x.name for x in pw.iterdir())).encode())
+    except OSError:
+        h.update(b"pw:none")
+    return h.hexdigest()[:16]
+
