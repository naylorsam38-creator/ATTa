@@ -0,0 +1,67 @@
+"""Consolidation: the additive control layer (atta_control) gates BOTH repair paths of the consolidated system:
+maintenance.py's self-healing (as the additive-control release shipped it) and the v121.3 in-job repair cycle
+(app_runner._repair_cycle -> _apply), which the additive-control release predates.
+
+The real runner, repair cycle, known_fixes, repair_actions (the REAL chmod_launcher) and control gate run; only
+Docker is stood in (the v121.3 harness).
+Run: python3 -m pytest -q tests/test_consolidated_control.py
+"""
+import json, os, sys, unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(HERE / "tests"))
+
+from test_v121_3_stop_fix_retest import _Env  # noqa: E402
+
+
+def audit(root):
+    f = root / "state" / "control" / "repair-audit.jsonl"
+    return [json.loads(x) for x in f.read_text().splitlines()] if f.is_file() else []
+
+
+class InJobRepairIsGated(_Env):
+    def tearDown(self):
+        for k in ("ATTA_CONTROL_ENFORCE", "ATTA_CONTROL_EVIDENCE_MAX_AGE"):
+            os.environ.pop(k, None)
+        super().tearDown()
+
+    def test_default_audits_the_repair_and_it_still_resolves(self):
+        os.environ.pop("ATTA_CONTROL_ENFORCE", None)
+        self.app("launch", executable=False)
+        self.stub_start(); self.watcher(self.launcher_decides)
+        r = self.job("launch")
+        self.assertEqual(r["handoff_state"], "QUALIFIED")                  # unchanged v121.3 behaviour
+        self.assertEqual(r["repair"]["status"], "RESOLVED")
+        ev = audit(self.root)
+        kinds = [e["event"] for e in ev]
+        self.assertEqual(kinds, ["REPAIR_AUTHORIZATION", "REPAIR_STARTED", "REPAIR_RETURNED"])
+        auth = ev[0]
+        self.assertTrue(auth["authorized"], auth)                         # full identity + fresh evidence
+        self.assertEqual(auth["fix_name"], "chmod_launcher")
+        self.assertEqual(auth["classification"], "runner-tier1")
+        self.assertEqual(auth["identity"]["app"], "launch")
+        rec = json.loads(Path(r["repair"]["first_failure"]).read_text())
+        self.assertEqual(auth["identity"]["run_id"], rec["run_id"])        # the job's own identity
+        self.assertEqual(auth["identity"]["correlation_id"], rec["correlation_id"])
+        self.assertTrue(auth["identity"]["app_revision"].startswith("app:"))
+        self.assertFalse(ev[1]["enforced"])
+
+    def test_enforced_gate_refuses_a_stale_repair_and_nothing_changes(self):
+        os.environ["ATTA_CONTROL_ENFORCE"] = "1"
+        os.environ["ATTA_CONTROL_EVIDENCE_MAX_AGE"] = "-1"                # every failure record counts as stale
+        d = self.app("stale", executable=False)
+        self.stub_start(); self.watcher(self.launcher_decides)
+        r = self.job("stale")
+        self.assertEqual(r["repair"]["status"], "FIX_FAILED")
+        self.assertIn("evidence is stale", r["repair"]["cycles"][0]["next"])
+        self.assertFalse(os.access(d / ".ui-capability" / "run-ui.sh", os.X_OK))   # the action never ran
+        self.assertEqual(self.checks["stale"], 1)                         # no retest of an unchanged condition
+        ev = audit(self.root)
+        self.assertEqual([e["event"] for e in ev], ["REPAIR_AUTHORIZATION"])
+        self.assertFalse(ev[0]["authorized"])
+        self.assertNotEqual(r["handoff_state"], "QUALIFIED")
+
+
+if __name__ == "__main__":
+    unittest.main()
