+from __future__ import annotations
+from dataclasses import dataclass
+from enum import Enum
+from typing import Mapping
+
+class Action(str,Enum):
+    AUTO="AUTO"; APPROVAL_REQUIRED="APPROVAL_REQUIRED"; RETRY_ONLY="RETRY_ONLY"
+    ESCALATE="ESCALATE"; NO_ACTION="NO_ACTION"
+
+@dataclass(frozen=True)
+class PolicyDecision:
+    action:Action
+    policy_version:str
+    reason:str
+
+@dataclass(frozen=True)
+class RepairPolicy:
+    version:str
+    mappings:Mapping[tuple[str,str],Action]
+    def decide(self,classification:str,fix_name:str)->PolicyDecision:
+        action=self.mappings.get((classification,fix_name))
+        if action is None:
+            return PolicyDecision(Action.ESCALATE,self.version,"No explicit classification/fix mapping")
+        return PolicyDecision(action,self.version,"Explicit policy mapping")
