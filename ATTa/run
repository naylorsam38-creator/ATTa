#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# One command. Turn the machine on, open a terminal here, type:  bash run
#
#   - On a real Linux server (EC2 / systemd, as root): runs the full deploy
#     via bootstrap.sh — installs services, nginx, browser stage, everything.
#   - On a laptop (macOS / Windows-WSL / non-root Linux): brings up the working
#     LOCAL instance you can log into and upload to in a browser, at a
#     127.0.0.1 URL, with the login password generated for you.
#
# It generates the secrets for you, so nothing stalls waiting on a password.
#
# HONEST LIMITATION (no script can change this): a public, live URL needs the
# actual AWS box — a domain, a TLS certificate, and the machine reachable on
# the internet. Those do not live in a file. On a laptop this gives you the
# real thing running locally; it does not pretend to be a public deployment.
# ---------------------------------------------------------------------------
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
DEPLOY="$HERE/04-deployment"
CMD="${1:-start}"

say(){ printf '%s\n' "$*"; }
line(){ printf '%s\n' "------------------------------------------------------------"; }

need_python(){
  if ! command -v python3 >/dev/null 2>&1; then
    say "python3 is not installed. Install Python 3, then run this again."
    say "  macOS:    brew install python"
    say "  Ubuntu:   sudo apt-get install -y python3"
    exit 1
  fi
}

# --- Full server deploy path -------------------------------------------------
is_systemd_linux(){ [ "$(uname -s)" = "Linux" ] && [ -d /run/systemd/system ]; }

full_deploy(){
  if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
      say "This is a Linux server — running the full deploy (needs root)."
      exec sudo -E bash "$0" "$@"
    fi
    say "Full server deploy needs root. Re-run as:  sudo bash run"
    exit 1
  fi
  line; say "FULL SERVER DEPLOY (bootstrap.sh)"; line
  bash "$DEPLOY/bootstrap.sh"
  # bootstrap.sh prints DEPLOYMENT VERIFIED and the login file location itself.
}

# --- Local laptop instance ---------------------------------------------------
# v117: all of it is local_launcher.py — .env read as data (never sourced), every process identified by pid + start
# time + command line before it is signalled, RUNNING only when the gateway proves it is this instance AND the
# pipeline is alive with a fresh heartbeat, one lock around start/stop. See its docstring.
local_launcher(){ need_python; python3 "$DEPLOY/local_launcher.py" "$@"; }

case "$CMD" in
  stop|status)
    if is_systemd_linux && [ -e /opt/app-builder ]; then
      say "This is a server: its services are managed by systemd and ADM. Try:  deployctl status"
    fi
    local_launcher "$CMD" ;;
  start|"")
    if is_systemd_linux; then full_deploy "$@"; else local_launcher start; fi ;;
  *) say "Usage: bash run [start|stop|status]"; exit 1 ;;
esac

