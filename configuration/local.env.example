# Copy to configuration/local.env (git-ignored) and fill in. Never commit real values.
ATTA_ENV=development
# Runtime role atta_app (data access only)
ATTA_DATABASE_PASSWORD=change-me
# Migration role atta (schema owner) - only `python -m backend.database migrate` uses it
ATTA_DATABASE_MIGRATION_PASSWORD=change-me
# ATTA_REDIS_PASSWORD=
ATTA_S3_ACCESS_KEY_ID=change-me
ATTA_S3_SECRET_ACCESS_KEY=change-me
# Model locations, separated by ';' on Windows and ':' on Linux. Removable drives are fine.
# ATTA_MODEL_PATHS=D:\models;E:\atta-models
# Any setting: ATTA__SECTION__KEY=value, e.g.
# ATTA__API__PORT=8801
# ATTA__SERVICES__POSTGRES__MODE=external
