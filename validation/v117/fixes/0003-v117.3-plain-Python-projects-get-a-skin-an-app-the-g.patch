diff --git a/ATTa/04-deployment/pipeline.py b/ATTa/04-deployment/pipeline.py
index 3010ca5..d3217be 100644
--- a/ATTa/04-deployment/pipeline.py
+++ b/ATTa/04-deployment/pipeline.py
@@ -635,6 +635,16 @@ def process(b):
         # Gate: nothing goes downstream until the browser check has passed, per app.
         step('QUALIFYING')
         st,apps,why,results=qualify()
+        # An app this build added that the gate never ran (e.g. the skins installer did not take it) must not
+        # hide inside a QUALIFIED build: say so, and the build is not fully qualified.
+        sid=lambda n: re.sub(r'[^a-z0-9-]+','-',str(n).lower()).strip('-')
+        checked={sid(a.get('app')) for a in apps}
+        unchecked=[n for n in (added or []) if sid(n) not in checked]
+        if unchecked:
+            builds.update(bid,apps_not_checked=unchecked)
+            why=(why+'; ' if why else '')+'NOT CHECKED (no skin/target was installed for them, so nothing ran them): '+', '.join(unchecked)
+            if st==builds.QUALIFIED:
+                st=builds.PARTIALLY_QUALIFIED if any(a.get('qualified') for a in apps) else builds.NOT_QUALIFIED
         state(state=st)
         _record_qualification(bid,st,apps,why,results)
         return st
