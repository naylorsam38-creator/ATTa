--- /dev/null
+++ b/ATTa/tests/test_v117_validation_fixes.py
@@ -0,0 +1,163 @@
+"""Fixes from the v117 validation run (validation/v117 on the validation branch): each test is the failure that was
+seen on a real server/laptop, reduced to the part the code decides.
+
+    cd ATTa && python3 -m unittest tests.test_v117_validation_fixes -v
+"""
+import os, shutil, stat, sys, tempfile, unittest, zipfile
+from pathlib import Path
+from unittest import mock
+
+HERE = Path(__file__).resolve().parent
+DEP = HERE.parent / "04-deployment"
+TMP = Path(tempfile.mkdtemp(prefix="atta-v117fix-"))
+os.environ.setdefault("APP_BUILDER_ROOT", str(TMP / "root"))
+os.environ.setdefault("ATTA_ADM_ROOT", str(TMP / "adm"))
+for p in (str(DEP), str(DEP / "deployd")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+
+import app_owners, builds, failure_keys, known_fixes, pipeline, proxy_launch, repair_actions, safe_copy  # noqa: E402
+
+# The exact error a seed clone produced on the validation server (git puts "fatal:" on its own line).
+GIT_ERR = ("['git', '-c', 'protocol.allow=never', 'clone', '--depth', '1', '--', 'https://github.com/moby/moby.git', "
+           "'/srv/app-builder/library/docker-moby'] -> 128:  Cloning into '/srv/app-builder/library/docker-moby'...\n"
+           "fatal: unable to access 'https://github.com/moby/moby.git/': Could not resolve host: github.com\n")
+CERT_ERR = GIT_ERR.replace("Could not resolve host: github.com",
+                           "server certificate verification failed. CAfile: none CRLfile: none")
+
+
+class GitErrorsAreRecognised(unittest.TestCase):
+    def test_known_fix_matches_multiline_git_error(self):
+        fix = known_fixes.match("build", {"key": GIT_ERR[:160], "detail": GIT_ERR}, "b-x")
+        self.assertIsNotNone(fix)
+        self.assertEqual(fix["rule"], "build.git_network")
+        self.assertTrue(fix.get("retry"))
+
+    def test_failure_key_is_a_family_not_unknown(self):
+        self.assertEqual(failure_keys.normalise("build", GIT_ERR[:160], GIT_ERR), "GIT_NETWORK")
+
+    def test_certificate_failure_is_permanent_so_the_seed_is_skipped(self):
+        self.assertTrue(pipeline.TRANSIENT_GIT.search(CERT_ERR))
+        self.assertTrue(pipeline.PERMANENT_GIT.search(CERT_ERR))
+        self.assertFalse(pipeline.PERMANENT_GIT.search(GIT_ERR))   # a DNS failure is still retried
+
+    def test_library_records_an_unavailable_seed_and_carries_on(self):
+        pipeline.LIB.mkdir(parents=True, exist_ok=True)
+        pipeline.MANIFEST.write_text('{"entries": [{"app": "Docker", "repository": "moby/moby"}]}')
+        try:
+            with mock.patch.object(pipeline, "run", side_effect=RuntimeError(CERT_ERR)):
+                out = pipeline.library()
+        finally:
+            pipeline.MANIFEST.unlink()
+        self.assertEqual(out[0]["result"], "REPO_UNAVAILABLE")
+
+
+class CopiesNeverSetSetgid(unittest.TestCase):
+    """systemd RestrictSUIDSGID=yes refuses chmod() calls that set setgid; the data folder is setgid (3771)."""
+
+    def test_copytree_never_chmods_a_folder_with_setgid(self):
+        src = TMP / "src-tree"; (src / "a" / "b").mkdir(parents=True)
+        (src / "a" / "b" / "f.txt").write_text("x"); (src / "run-ui.sh").write_text("#!/bin/sh\n")
+        os.chmod(src / "run-ui.sh", 0o755)
+        for d in (src, src / "a", src / "a" / "b"):
+            os.chmod(d, 0o2750)
+        real = os.chmod
+
+        def guarded(path, mode, *a, **k):
+            if mode & (stat.S_ISGID | stat.S_ISUID):
+                raise PermissionError(1, "Operation not permitted (RestrictSUIDSGID)", str(path))
+            return real(path, mode, *a, **k)
+
+        dst = TMP / "dst-tree"
+        with mock.patch("os.chmod", guarded):
+            safe_copy.copytree(src, dst)
+            with self.assertRaises(shutil.Error):           # what the services hit before the fix
+                shutil.copytree(src, TMP / "dst-std")
+        self.assertEqual((dst / "a" / "b" / "f.txt").read_text(), "x")
+        self.assertTrue(os.access(dst / "run-ui.sh", os.X_OK))
+
+    def test_shipped_skin_installer_does_not_use_copytree(self):
+        pkg = HERE.parent / "03-ui-skins-capability-package" / "UI_Skin_Capability_OneShot_v2.zip"
+        src = zipfile.ZipFile(pkg).read("out/install_all.py").decode()
+        self.assertNotIn("shutil.copytree(src,dst)", src)
+        self.assertIn("S_ISGID", src)
+
+
+class RestartResumesHealing(unittest.TestCase):
+    def test_a_heal_left_mid_round_is_carried_on(self):
+        rec = builds.create("tester01", origin="web", bundle="x.zip")
+        builds.update(rec["id"], state=builds.NOT_QUALIFIED,
+                      healing={"qualify": {"status": "HEALING", "rounds": 1, "items": {}, "chain": [], "alerted": []}})
+        with mock.patch("maintenance.heal", return_value="ESCALATED") as heal:
+            import maintenance
+            done = maintenance.resume_interrupted()
+        self.assertIn((rec["id"], "qualify", "ESCALATED"), done)
+        heal.assert_any_call(rec["id"], "qualify")
+
+
+class BrowserRepair(unittest.TestCase):
+    def test_pinned_version_comes_from_requirements(self):
+        self.assertEqual(repair_actions._pinned_playwright(), "playwright==1.60.0")
+
+    def test_missing_system_libraries_are_a_clear_human_step_when_not_root(self):
+        done = mock.Mock(returncode=0, stdout="", stderr="")
+        with mock.patch.dict(sys.modules, {"playwright": mock.Mock()}), \
+             mock.patch.object(repair_actions.subprocess, "run", return_value=done), \
+             mock.patch.object(repair_actions, "_browser_launch_error",
+                               return_value="chrome: error while loading shared libraries: libglib-2.0.so.0"), \
+             mock.patch.object(repair_actions.os, "geteuid", return_value=1000):
+            with self.assertRaisesRegex(repair_actions.ActionError, "install-deps"):
+                repair_actions.install_browser()
+
+    def test_browser_exception_with_missing_libraries_has_a_known_fix(self):
+        item = {"key": "6 CLEAN:BROWSER_EXCEPTION", "app": "a",
+                "detail": "BrowserType.launch: chrome: error while loading shared libraries: libnss3.so"}
+        fix = known_fixes.match("qualify", item, "b-x")
+        self.assertEqual(fix["rule"], "qualify.browser_missing")
+
+
+class LaptopRunAsRoot(unittest.TestCase):
+    def test_local_instance_is_not_a_server_even_as_root(self):
+        env = {k: v for k, v in os.environ.items() if k != "INVOCATION_ID"}
+        env["APP_BUILDER_LOCAL"] = "1"
+        with mock.patch.dict(os.environ, env, clear=True), mock.patch("os.geteuid", return_value=0):
+            self.assertFalse(proxy_launch._on_server())
+        env["INVOCATION_ID"] = "x"      # a systemd service can never claim to be a laptop
+        with mock.patch.dict(os.environ, env, clear=True), mock.patch("os.geteuid", return_value=0):
+            self.assertTrue(proxy_launch._on_server())
+
+
+class OwnerReupload(unittest.TestCase):
+    def _zip_stage(self, name, text):
+        stage = Path(tempfile.mkdtemp(dir=TMP)) / name
+        stage.mkdir()
+        (stage / "Dockerfile").write_text("FROM nginx:alpine\nCOPY index.html /usr/share/nginx/html/\n")
+        (stage / "index.html").write_text(text)
+        return stage.parent
+
+    def test_owner_update_replaces_the_library_copy_and_others_are_refused(self):
+        name = "reupload-site"
+        b1 = builds.create("tester01", origin="web", bundle="a.zip")["id"]
+        added, kept = pipeline.ingest_upload(self._zip_stage(name, "v1"), b1, "tester01", f"{name}.zip")
+        app_owners.record(name, "tester01", b1)
+        self.assertEqual((added, kept), ([name], []))
+        (pipeline.LIB / name / ".ui-capability").mkdir()
+        (pipeline.LIB / name / ".ui-capability" / "skin.css").write_text("kept")
+
+        b2 = builds.create("tester01", origin="web", bundle="b.zip")["id"]
+        added, kept = pipeline.ingest_upload(self._zip_stage(name, "v2"), b2, "tester01", f"{name}.zip")
+        self.assertEqual(added, [name])
+        self.assertEqual((pipeline.LIB / name / "index.html").read_text(), "v2")
+        self.assertEqual((pipeline.LIB / name / ".ui-capability" / "skin.css").read_text(), "kept")
+        self.assertTrue((pipeline.STATE / "runner" / "rebuild" / name).is_file())
+        self.assertEqual(builds.get(b2)["apps_updated"], [name])
+
+        b3 = builds.create("tester02", origin="web", bundle="c.zip")["id"]
+        with self.assertRaisesRegex(RuntimeError, "belongs to another account"):
+            pipeline.ingest_upload(self._zip_stage(name, "evil"), b3, "tester02", f"{name}.zip")
+        self.assertEqual((pipeline.LIB / name / "index.html").read_text(), "v2")
+        self.assertTrue(builds.get(b3)["refused"])
+
+
+if __name__ == "__main__":
+    unittest.main()
