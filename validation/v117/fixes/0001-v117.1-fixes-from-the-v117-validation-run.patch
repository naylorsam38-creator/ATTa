+"""Directory copies that work inside ATTa's hardened services.
+
+The data folder is setgid (root:atta 3771), so every folder under it carries the setgid bit, and the services
+run with systemd's RestrictSUIDSGID=yes, which refuses any chmod() that sets setuid/setgid. shutil.copytree()
+ends every folder with copystat(), i.e. chmod(dst, <source mode incl. setgid>) -> EPERM, and the whole copy fails.
+
+copytree() here copies the same way (files with copy2, symlinks kept as links when asked, the same ignore
+callback) but never chmods a folder: a new folder gets its mode from mkdir (umask) and inherits setgid from its
+parent, exactly as the data folder's layout intends. File modes are copied without setuid/setgid bits.
+"""
+from __future__ import annotations
+
+import os
+import shutil
+import stat
+from pathlib import Path
+
+
+def copytree(src, dst, symlinks: bool = False, ignore=None) -> Path:
+    src, dst = Path(src), Path(dst)
+    names = os.listdir(src)
+    skip = set(ignore(str(src), names)) if ignore else set()
+    os.makedirs(dst)                      # like shutil.copytree: the destination must not exist yet
+    errors = []
+    for name in names:
+        if name in skip:
+            continue
+        s, d = src / name, dst / name
+        try:
+            if s.is_symlink() and symlinks:
+                os.symlink(os.readlink(s), d)
+            elif s.is_dir():
+                copytree(s, d, symlinks, ignore)
+            else:
+                shutil.copyfile(s, d, follow_symlinks=True)
+                st = os.stat(s)
+                os.chmod(d, stat.S_IMODE(st.st_mode) & ~(stat.S_ISUID | stat.S_ISGID))
+                os.utime(d, ns=(st.st_atime_ns, st.st_mtime_ns))
+        except shutil.Error as e:
+            errors.extend(e.args[0])
+        except OSError as e:
+            errors.append((str(s), str(d), str(e)))
+    if errors:
+        raise shutil.Error(errors)
+    return dst
