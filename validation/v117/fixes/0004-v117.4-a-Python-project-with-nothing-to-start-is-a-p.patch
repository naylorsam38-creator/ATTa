Subject: [PATCH 4/4] v117.4: a Python project with nothing to start is a
 package (build-readiness check), not a web app

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AQwycJi8eqTo6GVPCjUZqa
---
 ATTa/04-deployment/intake.py             | 25 ++++++++++++++++++++++++
 ATTa/release.json                        |  5 +++--
 ATTa/tests/test_v117_validation_fixes.py | 18 +++++++++++++++++
 3 files changed, 46 insertions(+), 2 deletions(-)

diff --git a/ATTa/04-deployment/intake.py b/ATTa/04-deployment/intake.py
index e23a294..5bb4a99 100644
--- a/ATTa/04-deployment/intake.py
+++ b/ATTa/04-deployment/intake.py
@@ -82,9 +82,34 @@ def classify(app: Path, frameworks: list[str]) -> str:
         # Server-rendered Go apps (Gitea): the UI is Go templates plus a web_src/ bundle.
         web_ui = web_ui or (app / 'web_src').is_dir() or _has_page_templates(app)
         return 'web' if web_ui else 'service'
+    if _python_library(app):
+        return 'package'
     return 'web'
 
 
+# Python code that starts a server imports one of these; a library/tool that never does is not an app to run.
+_PY_SERVER = re.compile(r'^\s*(from|import)\s+(fastapi|flask|django|uvicorn|gunicorn|aiohttp|starlette|streamlit|'
+                        r'gradio|tornado|sanic|bottle|http\.server|socketserver|quart|litestar)\b', re.M)
+
+
+def _python_library(app: Path) -> bool:
+    """A Python project with nothing to start: no container recipe, no web pages, and no module that imports a
+    server framework (e.g. a controller library with its tests). Its check is build readiness, not a browser."""
+    if any((app / n).exists() for n in ('Dockerfile', 'docker-compose.yml', 'docker-compose.yaml', 'compose.yml',
+                                          'compose.yaml', 'package.json', 'manage.py', 'Procfile', 'app.json')):
+        return False
+    py = [f for f in app.rglob('*.py') if not (set(f.relative_to(app).parts) & _SKIP) and '.ui-capability' not in f.parts]
+    if not py or web_evidence(app):
+        return False
+    for f in py[:400]:
+        try:
+            if _PY_SERVER.search(f.read_text(errors='replace')):
+                return False
+        except OSError:
+            continue
+    return True
+
+
 def _has_page_templates(app: Path) -> bool:
     t = app / 'templates'
     if not t.is_dir():
