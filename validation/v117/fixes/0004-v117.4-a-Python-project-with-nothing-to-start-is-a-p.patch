     "v117_1_validation_fixes_git_retry_setgid_copy_resume_heals_browser_deps_adm_test_gate_owner_reupload_local_root_seed_once",
     "v117_2_proxy_dirs_without_setgid_builds_from_normalised_copy_plain_python_projects_discovered",
-    "v117_3_skins_installer_takes_plain_python_projects_unchecked_apps_never_hide_in_qualified"
+    "v117_3_skins_installer_takes_plain_python_projects_unchecked_apps_never_hide_in_qualified",
+    "v117_4_python_libraries_qualify_as_packages"
   ]
 }
diff --git a/ATTa/tests/test_v117_validation_fixes.py b/ATTa/tests/test_v117_validation_fixes.py
index e81d084..ab8a35f 100644
--- a/ATTa/tests/test_v117_validation_fixes.py
+++ b/ATTa/tests/test_v117_validation_fixes.py
@@ -185,5 +185,23 @@ class PlainPythonProjectsAreApps(unittest.TestCase):
         self.assertFalse(app_classifier._has_marker(d))
 
 
+class PythonLibrariesArePackages(unittest.TestCase):
+    def _proj(self, name, files):
+        d = TMP / name; d.mkdir()
+        for n, t in files.items():
+            (d / n).write_text(t)
+        return d
+
+    def test_python_library_without_a_server_is_a_package(self):
+        import intake
+        d = self._proj("pylib", {"controller.py": "import json\n", "test_controller.py": "import unittest\n"})
+        self.assertEqual(intake.classify(d, intake.fingerprint(d)), "package")
+
+    def test_python_code_that_starts_a_server_is_not(self):
+        import intake
+        d = self._proj("pyapi", {"main.py": "from fastapi import FastAPI\n", "util.py": "x = 1\n"})
+        self.assertEqual(intake.classify(d, intake.fingerprint(d)), "web")
+
+
 if __name__ == "__main__":
     unittest.main()
