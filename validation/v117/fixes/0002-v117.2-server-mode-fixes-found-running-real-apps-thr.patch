index 65ab031..d68b1d5 100644
--- a/ATTa/04-deployment/app_classifier.py
+++ b/ATTa/04-deployment/app_classifier.py
@@ -23,9 +23,16 @@ SKIP_DIRS = {'node_modules', '.git', 'vendor', 'test', 'tests', 'testing', 'docs
 PREFERRED = ('app', 'server', 'backend', 'web', 'api', 'platform', 'src')
 
 
+# A plain Python project (modules + tests, no packaging file yet) is still code: two or more .py modules in one
+# folder count as a marker. One loose script does not (many repos carry a helper .py beside other code).
+PY_MODULES_MIN = 2
+
+
 def _has_marker(d: Path) -> bool:
     try:
-        return any((d / m).is_file() for m in ROOT_MARKERS) or any(SLN.match(p.name) for p in d.iterdir() if p.is_file())
+        files = [p for p in d.iterdir() if p.is_file()]
+        return (any((d / m).is_file() for m in ROOT_MARKERS) or any(SLN.match(p.name) for p in files)
+                or sum(1 for p in files if p.suffix == ".py" and p.name != "__init__.py") >= PY_MODULES_MIN)
     except OSError:
         return False
 
diff --git a/ATTa/04-deployment/app_runner.py b/ATTa/04-deployment/app_runner.py
index 620343b..9713b62 100644
--- a/ATTa/04-deployment/app_runner.py
+++ b/ATTa/04-deployment/app_runner.py
@@ -987,6 +987,24 @@ def host_access_for(app: str, notes: list[str]) -> bool:
     return False
 
 
+def build_source(app: str, d: Path) -> Path:
+    """A copy of the app to build images from, with ordinary file modes (files 0644, executables 0755, folders
+    0755). On a server the library is 0640/0750 (UMask 0027, o-rwx) and a Dockerfile's COPY keeps those modes in
+    the image, so a non-root process in the container (nginx's worker, a node user) cannot read its own files
+    and answers 403. The library itself stays locked down; only this build copy is normalised."""
+    dst = WORK / safe_id(app) / "build-src"
+    if dst.exists():
+        shutil.rmtree(dst)
+    safe_copy.copytree(d, dst, symlinks=True, ignore=shutil.ignore_patterns(".git", ".ui-capability"))
+    for dirpath, dirnames, filenames in os.walk(dst):
+        os.chmod(dirpath, 0o755)
+        for n in filenames:
+            f = Path(dirpath) / n
+            if not f.is_symlink():
+                os.chmod(f, 0o755 if os.stat(f).st_mode & 0o100 else 0o644)
+    return dst
+
+
 def _render_compose(app: str, d: Path, part: dict, notes: list[str]) -> tuple[bool, str]:
     f = d / part["file"]
     _ensure_env_file(d, f, notes)
@@ -1112,6 +1130,15 @@ def _render_compose(app: str, d: Path, part: dict, notes: list[str]) -> tuple[bo
     cfg["name"] = project(app)
     wd = WORK / safe_id(app); wd.mkdir(parents=True, exist_ok=True)
     # v115: it holds the app's approved customer secrets, so only the runner (root) may read it.
+    # Services built from the app's source build from the normalised copy (see build_source).
+    if any(isinstance(sv, dict) and sv.get("build") for sv in (cfg.get("services") or {}).values()):
+        src = build_source(app, d)
+        for sv in (cfg.get("services") or {}).values():
+            b = sv.get("build") if isinstance(sv, dict) else None
+            if isinstance(b, dict) and b.get("context"):
+                c = Path(b["context"])
+                if c.is_absolute() and (c == d or d in c.parents):
+                    b["context"] = str(src / c.relative_to(d))
     rendered = wd / "compose.rendered.json"
     rendered.unlink(missing_ok=True)
     fd = os.open(rendered, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
@@ -1153,8 +1180,9 @@ def _start_inner(app: str, d: Path, part: dict, notes: list[str]) -> tuple[bool,
     image = part.get("image")
     if part["kind"] == "dockerfile":
         image = f"atta-local/{safe_id(app)}:latest"
-        ctx = d / part.get("context", ".")
-        rc, out = sh(["docker", "build", "-t", image, "-f", str(d / part["dockerfile"]), str(ctx)], timeout=BUILD_TIMEOUT)
+        src = build_source(app, d)
+        ctx = src / part.get("context", ".")
+        rc, out = sh(["docker", "build", "-t", image, "-f", str(src / part["dockerfile"]), str(ctx)], timeout=BUILD_TIMEOUT)
         if rc != 0:
             return False, out[-6000:]
     else:
diff --git a/ATTa/04-deployment/proxy_launch.py b/ATTa/04-deployment/proxy_launch.py
index d6242fe..daca5f0 100644
--- a/ATTa/04-deployment/proxy_launch.py
+++ b/ATTa/04-deployment/proxy_launch.py
@@ -124,7 +124,9 @@ def _prepare(app: str, ui_dir: Path) -> Path:
             except PermissionError:
                 raise LaunchError(f"cannot hand {d} to group {grp.getgrgid(gid).gr_name}; "
                                   f"the service user must be in that group (bootstrap.sh sets this)")
-            os.chmod(d, 0o2770)
+            # 0770, not 2770: the services run with RestrictSUIDSGID=yes, which refuses a chmod that sets setgid.
+            # Not needed either: the folder's group is the proxy user's own group, so what it writes stays shared.
+            os.chmod(d, 0o770)
     return dest
 
 
