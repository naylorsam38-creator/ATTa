@@ -159,5 +160,30 @@ class OwnerReupload(unittest.TestCase):
         self.assertTrue(builds.get(b3)["refused"])
 
 
+class ServerBuildsReadTheirOwnFiles(unittest.TestCase):
+    def test_build_copy_has_ordinary_modes_and_skips_git(self):
+        app = TMP / "lib-app"; (app / "public").mkdir(parents=True); (app / ".git").mkdir()
+        (app / "public" / "index.html").write_text("<h1>x</h1>"); (app / "run.sh").write_text("#!/bin/sh\n")
+        os.chmod(app / "public" / "index.html", 0o640); os.chmod(app / "run.sh", 0o750)
+        os.chmod(app / "public", 0o2750)
+        src = app_runner.build_source("lib-app", app)
+        self.assertEqual(stat.S_IMODE(os.stat(src / "public" / "index.html").st_mode), 0o644)
+        self.assertEqual(stat.S_IMODE(os.stat(src / "run.sh").st_mode), 0o755)
+        self.assertEqual(stat.S_IMODE(os.stat(src / "public").st_mode), 0o755)
+        self.assertFalse((src / ".git").exists())
+        self.assertEqual(stat.S_IMODE(os.stat(app / "public" / "index.html").st_mode), 0o640)   # library untouched
+
+
+class PlainPythonProjectsAreApps(unittest.TestCase):
+    def test_modules_without_a_packaging_file_are_code(self):
+        d = TMP / "py-proj"; d.mkdir()
+        (d / "controller.py").write_text("x = 1\n"); (d / "test_controller.py").write_text("import controller\n")
+        self.assertTrue(app_classifier._has_marker(d))
+
+    def test_one_loose_script_is_not(self):
+        d = TMP / "one-script"; d.mkdir(); (d / "helper.py").write_text("print(1)\n")
+        self.assertFalse(app_classifier._has_marker(d))
+
+
 if __name__ == "__main__":
     unittest.main()
