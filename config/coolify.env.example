# ATTa Coolify deploy kit - settings for scripts/install.sh
#
#   cp config/coolify.env.example config/coolify.env
#   nano config/coolify.env
#
# config/coolify.env is git-ignored because it holds the admin password. Never commit it.
# Format: KEY=value, one per line, no spaces around '='. Lines starting with # are ignored.

# Coolify version to install. 4.3.23 is the stable release this kit was tested against.
COOLIFY_VERSION=4.3.23

# ---- Admin account (created during install; public sign-up is then disabled) ----
# Letters, digits, '_' or '-'. 3-64 characters, no spaces.
ROOT_USERNAME=sam
# Must be a real address on a domain that accepts mail. Coolify checks DNS and rejects
# placeholder/reserved domains (example.com, *.test, *.local, *.internal ...).
ROOT_USER_EMAIL=you@example.com
# Leave empty to have a strong password generated for you (recommended). If you set one:
# 12+ characters with upper, lower, digit and one of  ! % * + , - . / : ; < = > ? @ ^ _ ~
# Avoid $ # & | \ quotes and spaces - they break Coolify's .env handling.
ROOT_USER_PASSWORD=

# Where the generated login is written (root-only file). Move it to a password manager.
CREDENTIALS_FILE=/root/coolify-admin-credentials.txt

# ---- Updates ----
# false = stay on COOLIFY_VERSION until you run scripts/upgrade.sh <version> (default).
#         ATTa's Coolify hand-off was verified against 4.3.23, so upgrade deliberately.
# true  = Coolify updates itself.
AUTOUPDATE=false

# ---- Installer source ----
# Path to the Coolify source zip (coolify-main.zip). When set, the installer is taken from
# it after checking its SHA-256 (default: the 4.3.23 zip ATTa v116 ships and pins) instead
# of being downloaded. Empty = download Coolify's official installer.
COOLIFY_SOURCE_ZIP=
# Only if you deliberately use a different zip: its SHA-256.
COOLIFY_SOURCE_ZIP_SHA256=

# ---- Advanced: leave empty unless you know you need them ----
# Private network range Docker hands out to containers. Change only if 10.0.0.0/8
# clashes with your VPC / VPN.
DOCKER_ADDRESS_POOL_BASE=
DOCKER_ADDRESS_POOL_SIZE=
# Alternative image registry (default docker.io; ghcr.io also hosts Coolify images).
REGISTRY_URL=
