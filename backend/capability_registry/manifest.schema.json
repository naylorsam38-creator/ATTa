{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atta.local/schemas/capability-manifest/v1",
  "title": "ATTa capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "version",
    "description",
    "handlers",
    "input_schema",
    "output_schema",
    "permissions",
    "risk",
    "dependencies",
    "timeout_s",
    "enabled"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "requirement": {
      "type": "string",
      "pattern": "^CAP-(0[1-9]|[1-3][0-9]|40)$"
    },
    "handlers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execute",
        "healthcheck",
        "verify"
      ],
      "properties": {
        "execute": {
          "$ref": "#/$defs/handler"
        },
        "healthcheck": {
          "$ref": "#/$defs/handler"
        },
        "verify": {
          "$ref": "#/$defs/handler"
        },
        "reconcile": {
          "$ref": "#/$defs/handler"
        }
      }
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_*]*)+$"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "python": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
          }
        }
      }
    },
    "timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "enabled": {
      "type": "boolean"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "handler": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "operations",
        "handler",
        "verify",
        "input_schema",
        "output_schema",
        "permissions",
        "risk",
        "timeout_s",
        "cancellable",
        "idempotency"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,40}$"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "task_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "handler": {
          "$ref": "#/$defs/handler"
        },
        "verify": {
          "$ref": "#/$defs/handler"
        },
        "input_schema": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "resource_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "path_arguments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "url_arguments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory_mb": {
              "type": "integer",
              "minimum": 64
            },
            "disk_mb": {
              "type": "integer",
              "minimum": 1
            },
            "network_requests": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cancellable": {
          "type": "boolean"
        },
        "idempotency": {
          "enum": [
            "idempotent",
            "non_idempotent",
            "external_uncertain"
          ]
        },
        "output_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
